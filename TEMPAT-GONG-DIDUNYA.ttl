wh:site_1751 a wh:WorldHeritageSite ;
    rdfs:label "محمية أوكفينوكي الوطنية للأحياء البرية"@ar,
        "Okefenokee National Wildlife Refuge"@en,
        "Refugio nacional de fauna y flora silvestres de Okefenokee"@es,
        "Refuge national de faune et de flore sauvages d’Okefenokee"@fr,
        "Национальный резерват дикой природы Окефеноки"@ru,
        "奥克弗诺基国家野生动物保护区"@zh ;
    wh:areaHectares 164565.5 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The property, located in southeastern Georgia and northeastern Florida, protects the Okefenokee Swamp, the largest lowland freshwater peatland in the subtropical zone worldwide and one of the largest and most intact ecosystems within the North American Coastal Plain global biodiversity hotspot. The property comprises a diverse mosaic of wetlands, savannas, and forests shaped by the ongoing interaction of water, fire, vegetation, and wildlife, with alternating fire and rainfall processes driving peat formation, vegetation structure, and biodiversity. The site also contains significant areas of endangered Longleaf Pine (Pinus palustris) savanna, of which less than 3% remains, supporting high concentrations of plant species endemic to the region. Its extensive peat deposits provide an important archive of palaeo-environmental history and critical carbon storage. The property supports exceptional biodiversity, including at least 856 plant species, 48 mammal species, 238 bird species, 39 fish species, and 90 reptile and amphibian species, and provides important habitat for migratory birds, threatened species, and a significant population of American alligators."@en ;
    wh:hasCategory wh:category_Natural ;
    wh:hasComponent wh:component_1751 ;
    wh:hasCriterion wh:criterion_ix,
        wh:criterion_x ;
    wh:hasImage wh:image_17518b9e09c43b77,
