wh:site_890 a wh:WorldHeritageSite ;
    rdfs:label "الوسط التاريخي لمدينة ديامانتينا"@ar,
        "Historic Centre of the Town of Diamantina"@en,
        "Centro histórico de Diamantina"@es,
        "Centre historique de la ville de Diamantina"@fr,
        "Исторический центр города Диамантина"@ru,
        "蒂阿曼蒂那城历史中心"@zh ;
    wh:areaHectares 28.5 ;
    wh:belongsToRegion wh:region_LAC ;
    wh:description "Diamantina, a colonial village set like a jewel in a necklace of inhospitable rocky mountains, recalls the exploits of diamond prospectors in the 18th century and testifies to the triumph of human cultural and artistic endeavour over the environment."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_890 ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_iv ;
    wh:hasImage wh:image_195bfe67a3922df2,
