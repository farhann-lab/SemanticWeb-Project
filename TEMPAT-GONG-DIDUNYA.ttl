        wh:component_1248bis-012 ;
    wh:hasCriterion wh:criterion_vii,
        wh:criterion_viii ;
    wh:hasImage wh:image_27316fcab6562e63,
        wh:image_38bdbd95a6bdd1a3,
        wh:image_420708a3f0558ec9,
        wh:image_432cfacd8e4d6902,
        wh:image_5a121398d581270a,
