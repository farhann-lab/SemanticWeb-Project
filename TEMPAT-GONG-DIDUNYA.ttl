wh:site_1471 a wh:WorldHeritageSite ;
    rdfs:label "مقبرة بيت شعاريم الكبيرة: مقام بارز في حركة التجدد اليهودي"@ar,
        "Necropolis of Bet She’arim: A Landmark of Jewish Renewal"@en,
        "Necrópolis de Bet She’arim – Sitio histórico de la renovación judía"@es,
        "Nécropole de Bet She’arim – Un haut lieu du renouveau juif"@fr,
        "Некрополь Бейт Шеарим - символ еврейского возрождения"@ru,
        "贝特沙瑞姆大型公墓—犹太复兴中心"@zh ;
    wh:areaHectares 12.2 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Consisting of a series of catacombs, the necropolis developed from the 2nd century AD as the primary Jewish burial place outside Jerusalem following the failure of the second Jewish revolt against Roman rule. Located southeast of the city of Haifa, these catacombs are a treasury of artworks and inscriptions in Greek, Aramaic, Hebrew and Palmyrene. Bet She’arim bears unique testimony to ancient Judaism under the leadership of Rabbi Judah the Patriarch, who is credited with Jewish renewal after 135 AD."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1471 ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_iii ;
