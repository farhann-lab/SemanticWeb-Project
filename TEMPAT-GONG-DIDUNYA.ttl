wh:site_327 a wh:WorldHeritageSite ;
    rdfs:label "قُصَير عمرة"@ar,
        "Quseir Amra"@en,
        "Quseir Amra"@es,
        "Qusair Amra"@fr,
        "Древняя резиденция халифов Кусейр-Амра"@ru,
