    rdfs:label "جزيرة هندرسون"@ar,
        "Henderson Island"@en,
        "Isla de Henderson"@es,
        "Île d'Henderson"@fr,
        "Остров Хендерсон (Южная Океания)"@ru,
        "享德森岛"@zh ;
