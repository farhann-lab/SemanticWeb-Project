wh:site_950 a wh:WorldHeritageSite ;
    rdfs:label "التلة الملكية في امبوهيمنغا"@ar,
        "Royal Hill of Ambohimanga"@en,
        "Colina real de Ambohimanga"@es,
        "Colline royale d'Ambohimanga"@fr,
        "Королевский холм Амбохиманга"@ru,
        "安布希曼加的皇家蓝山行宫"@zh ;
    wh:areaHectares 59.0 ;
    wh:belongsToRegion wh:region_AFR ;
    wh:description "The Royal Hill of Ambohimanga consists of a royal city and burial site, and an ensemble of sacred places. It is associated with strong feelings of national identity, and has maintained its spiritual and sacred character both in ritual practice and the popular imagination for the past 500 years. It remains a place of worship to which pilgrims come from Madagascar and elsewhere."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_950 ;
    wh:hasCriterion wh:criterion_iii,
        wh:criterion_iv ;
    wh:hasImage wh:image_0b5e1045c9abf372,
        wh:image_0f8385c626d638d6,
        wh:image_1c099495b1f147a4,
        wh:image_1ce38f7bbf0acf44,
