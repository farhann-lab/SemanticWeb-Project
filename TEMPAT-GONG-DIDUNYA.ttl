wh:site_1712 a wh:WorldHeritageSite ;
    rdfs:label "المنظر الثقافي لمنطقة الفاو الأثرية (المملكة العربية"@ar,
        "The Cultural Landscape of Al-Faw Archaeological Area"@en,
        "Paisaje cultural de la zona arqueológica de Al-Faw"@es,
        "Le paysage culturel de la zone archéologique d’Al-Faw"@fr,
        "Культурный ландшафт археологической зоны Аль-Фау"@ru,
        "法乌考古区文化景观"@zh ;
    wh:areaHectares 4847.73 ;
    wh:belongsToRegion wh:region_ARB ;
    wh:description "Lying at a strategic point of the ancient trade routes of the Arabian Peninsula, the property was abruptly abandoned around the 5th century CE. Nearly 12,000 archaeological remains have been found, spanning from prehistoric times to the Late pre-Islamic era, testifying to the successive occupation of three different populations and their adaptation to the evolving environmental conditions. Archaeological features include the Palaeolithic and Neolithic tools of early people, tapered structures, cairns and circular constructions, the sacred mountain of Khashm Qaryah, rock carvings, funerary tumuli and cairns in the valley, forts/caravanserai, the oasis and its ancient water management system, and the vestiges of the city of Qaryat al-Faw."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1712 ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_v ;
    wh:hasImage wh:image_1a1cca31e5f44555,
        wh:image_50554876cbf17a0e,
        wh:image_85fc06f4bd252b7a,
        wh:image_a27227a88e90e2f1,
        wh:image_a31cb571db17b972,
        wh:image_ad712d665212bae3,
        wh:image_b10c697f7f597e51,
        wh:image_bf9e5e066db9c439,
        wh:image_c82175a6d631df17,
        wh:image_e03c7aa72328abc4,
        wh:image_eccbd2577b05d2b1,
