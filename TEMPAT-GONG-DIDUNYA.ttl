wh:site_334 a wh:WorldHeritageSite ;
    rdfs:label "معبد بون جيسوس  في كونغونياش"@ar,
        "Sanctuary of Bom Jesus do Congonhas"@en,
        "Santuario del Buen Jesús de Congonhas"@es,
        "Sanctuaire du Bon Jésus à Congonhas"@fr,
        "Церковный комплекс Бон-Жесус-ду-Конгоньяс"@ru,
        "孔戈尼亚斯的仁慈耶稣圣殿"@zh ;
    wh:areaHectares 2.19 ;
    wh:belongsToRegion wh:region_LAC ;
    wh:description "This sanctuary in Minais Gerais, south of Belo Horizonte was built in the second half of the 18th century. It consists of a church with a magnificent Rococo interior of Italian inspiration; an outdoor stairway decorated with statues of the prophets; and seven chapels illustrating the Stations of the Cross, in which the polychrome sculptures by Aleijadinho are masterpieces of a highly original, moving, expressive form of Baroque art."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_334 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_iv ;
