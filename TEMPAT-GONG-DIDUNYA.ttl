    rdfs:label "نصب أوفييدو  وقصر الأستوريين"@ar,
        "Monuments of Oviedo and the Kingdom of the Asturias"@en,
        "Monumentos de Oviedo y del reino de Asturias"@es,
        "Monuments d’Oviedo et du royaume des Asturies"@fr,
        "Памятники Овьедо и королевства Астурия"@ru,
