wh:site_500 a wh:WorldHeritageSite ;
    rdfs:label "وسط ليما التاريخي"@ar,
        "Historic Centre of Lima"@en,
        "Centro histórico de Lima"@es,
        "Centre historique de Lima"@fr,
        "Исторический центр Лимы"@ru,
        "利马的历史中心"@zh ;
    wh:areaHectares 277.99 ;
    wh:belongsToRegion wh:region_LAC ;
    wh:description "Although severely damaged by earthquakes, this 'City of the Kings' was, until the middle of the 18th century, the capital and most important city of the Spanish dominions in South America. Many of its buildings, such as the Convent of San Francisco (the largest of its type in this part of the world), are the result of collaboration between local craftspeople and others from the Old World."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_500ter-001,
        wh:component_500ter-002,
        wh:component_500ter-003 ;
    wh:hasCriterion wh:criterion_iv ;
