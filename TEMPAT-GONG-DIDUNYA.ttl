wh:site_1561 a wh:WorldHeritageSite ;
    rdfs:label "تشوانتشو: مركز العالم التجاري في سونغ تشوان بالصين"@ar,
        "Quanzhou: Emporium of the World in Song-Yuan China"@en,
        "Quanzhou, emporio mundial de la China de los Song y los Yuan"@es,
        "Quanzhou : emporium mondial de la Chine des Song et des Yuan"@fr,
        "Цюаньчжоу: мировой центр торговли в Китае эпохи династий Сун-Юань"@ru,
        "泉州：宋元中国的世界海洋商贸中心"@zh ;
    wh:areaHectares 536.08 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "The serial site of Quanzhou illustrates the city’s vibrancy as a maritime emporium during the Song and Yuan periods (10th - 14th centuries AD) and its interconnection with the Chinese hinterland. Quanzhou thrived during a highly significant period for maritime trade in Asia. The site encompasses religious buildings, including the 11th century AD Qingjing Mosque, one of the earliest Islamic edifices in China, Islamic tombs, and a wide range of archaeological remains: administrative buildings, stone docks that were important for commerce and defence, sites of ceramic and iron production, elements of the city’s transportation network, ancient bridges, pagodas, and inscriptions. Known as Zayton in Arabic and western texts of the 10th to 14th centuries AD."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1561rev-001,
        wh:component_1561rev-002,
        wh:component_1561rev-003,
