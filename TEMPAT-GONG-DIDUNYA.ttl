    wh:description "Situated in the Cordillera Blanca, the world's highest tropical mountain range, Mount Huascarán rises to 6,768 m above sea-level. The deep ravines watered by numerous torrents, the glacial lakes and the variety of the vegetation make it a site of spectacular beauty. It is the home of such species as the spectacled bear and the Andean condor."@en ;
    wh:hasCategory wh:category_Natural ;
    wh:hasComponent wh:component_333 ;
    wh:hasCriterion wh:criterion_vii,
        wh:criterion_viii ;
    wh:hasImage wh:image_0573b76360d47b83,
        wh:image_15dbbdbc61bee8be,
        wh:image_1910c4fb90fd3611,
        wh:image_4636c9e9a5944bb2,
        wh:image_583b7bd6e25a75c0,
        wh:image_5d92d87b3a4562c1,
        wh:image_63859f3759ec6aa3,
        wh:image_a3728d67250aa2d6,
        wh:image_b791de533372242e,
