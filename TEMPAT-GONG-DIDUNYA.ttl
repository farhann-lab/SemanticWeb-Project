wh:site_861 a wh:WorldHeritageSite ;
    rdfs:label "محمية قرية هولاشوفيتسه التاريخية"@ar,
        "Holašovice Historic Village"@en,
        "Reserva de la aldea histórica de Holašovice"@es,
        "Village historique d’Holašovice"@fr,
        "Историческая деревня Голешовице"@ru,
        "霍拉索维采古村保护区"@zh ;
    wh:areaHectares 11.4 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Holašovice is an exceptionally complete and well-preserved example of a traditional central European village. It has a large number of outstanding 18th- and 19th-century vernacular buildings in a style known as 'South Bohemian folk Baroque', and preserves a ground plan dating from the Middle Ages."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_861 ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_iv ;
    wh:hasImage wh:image_04c8736b15b39035,
        wh:image_10ed579c41c8dae8,
        wh:image_1175cabcdbd5e468,
        wh:image_1a9e81ee5e813f60,
        wh:image_3092817844ed4ca8,
