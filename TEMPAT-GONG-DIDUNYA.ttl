wh:site_1077 a wh:WorldHeritageSite ;
    rdfs:label "تخت سليمان"@ar,
        "Takht-e Soleyman"@en,
        "Takht-e Sulaiman"@es,
        "Takht-e Sulaiman"@fr,
        "Древний город Техте-Солейман"@ru,
        "塔赫特苏莱曼"@zh ;
    wh:areaHectares 10.0 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "The archaeological site of Takht-e Soleyman, in north-western Iran, is situated in a valley set in a volcanic mountain region. The site includes the principal Zoroastrian sanctuary partly rebuilt in the Ilkhanid (Mongol) period (13th century) as well as a temple of the Sasanian period (6th and 7th centuries) dedicated to Anahita. The site has important symbolic significance. The designs of the fire temple, the palace and the general layout have strongly influenced the development of Islamic architecture."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1077 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_ii,
        wh:criterion_iii,
        wh:criterion_iv ;
