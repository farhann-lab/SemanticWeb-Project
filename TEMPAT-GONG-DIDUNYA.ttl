wh:site_267 a wh:WorldHeritageSite ;
    rdfs:label "مدينة برن القديمة"@ar,
        "Old City of Berne"@en,
        "Ciudad vieja de Berna"@es,
        "Vieille ville de Berne"@fr,
        "Старый город в Берне"@ru,
        "伯尔尼古城"@zh ;
    wh:areaHectares 91.86 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Founded in the 12th century on a hill site surrounded by the Aare River, Berne developed over the centuries in line with a an exceptionally coherent planning concept. The buildings in the Old City, dating from a variety of periods, include 15th-century arcades and 16th-century fountains. Most of the medieval town was restored in the 18th century but it has retained its original character."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_267 ;
    wh:hasCriterion wh:criterion_iii ;
