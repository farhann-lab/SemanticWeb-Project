wh:site_252 a wh:WorldHeritageSite ;
    rdfs:label "تاج محل"@ar,
        "Taj Mahal"@en,
        "Taj Mahal"@es,
        "Le Taj Mahal"@fr,
        "Мавзолей Тадж-Махал (город Агра)"@ru,
        "泰姬陵"@zh ;
    wh:areaHectares 0.0 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "An immense mausoleum of white marble, built in Agra between 1631 and 1648 by order of the Mughal emperor Shah Jahan in memory of his favourite wife, the Taj Mahal is the jewel of Muslim art in India and one of the universally admired masterpieces of the world's heritage."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_252 ;
    wh:hasCriterion wh:criterion_i ;
