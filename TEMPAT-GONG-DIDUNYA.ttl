wh:site_1501 a wh:WorldHeritageSite ;
    rdfs:label "موقع أضرحة أنتركيرا"@ar,
        "Antequera Dolmens Site"@en,
        "Dólmenes de Antequera"@es,
        "Site de dolmens d’Antequera"@fr,
        "Дольмены Антекеры"@ru ;
    wh:areaHectares 2446.3 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Located at the heart of Andalusia in southern Spain, the site comprises three megalithic monuments: the Menga and Viera dolmens and the Tholos of El Romeral, and two natural monuments: La Peña de los Enamorados and El Torcal mountainous formations, which are landmarks within the property. Built during the Neolithic and Bronze Age out of large stone blocks, these monuments form chambers with lintelled roofs or false cupolas. These three tombs, buried beneath their original earth tumuli, are one of the most remarkable architectural works of European prehistory and one of the most important examples of European Megalithism."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1501-001,
        wh:component_1501-002,
        wh:component_1501-003,
        wh:component_1501-004 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_iii,
        wh:criterion_iv ;
