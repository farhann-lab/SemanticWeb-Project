wh:site_803 a wh:WorldHeritageSite ;
    rdfs:label "لا ميدولاس"@ar,
        "Las Médulas"@en,
        "Las Médulas"@es,
        "Las Médulas"@fr,
        "Район древней золотодобычи Лас-Медулас"@ru,
        "拉斯梅德拉斯"@zh ;
    wh:areaHectares 2208.2 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "In the 1st century A.D. the Roman Imperial authorities began to exploit the gold deposits of this region in north-west Spain, using a technique based on hydraulic power. After two centuries of working the deposits, the Romans withdrew, leaving a devastated landscape. Since there was no subsequent industrial activity, the dramatic traces of this remarkable ancient technology are visible everywhere as sheer faces in the mountainsides and the vast areas of tailings, now used for agriculture."@en ;
    wh:hasCategory wh:category_Cultural ;
