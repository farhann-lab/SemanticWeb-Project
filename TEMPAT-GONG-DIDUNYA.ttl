wh:site_1735 a wh:WorldHeritageSite ;
    rdfs:label "جبل الفاية"@ar,
        "Faya Palaeolandscape"@en,
        "Paleopaisaje de Faya"@es,
        "Paléo-paysage de Faya"@fr,
        "Палеоландшафт Файя"@ru,
        "法亚古地貌"@zh ;
    wh:areaHectares 29085.0 ;
    wh:belongsToRegion wh:region_ARB ;
    wh:description "Located between the Persian Gulf and Arabian Sea, the property preserves evidence of human occupation from the Middle Palaeolithic and Neolithic periods (210,000–6,000 years ago). Archaeological layers reveal how hunter-gatherers and pastoralists adapted to extreme climates, alternating between arid and rainy periods every 20,000 years. Beyond subsistence activities, early human groups utilized the site's geomorphological features for resource extraction. With diverse water sources and raw materials, Faya provides valuable insights into human resilience in hyper-arid environments."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1735 ;
    wh:hasCriterion wh:criterion_iii,
        wh:criterion_iv ;
    wh:hasImage wh:image_08192e37a44fb59d,
