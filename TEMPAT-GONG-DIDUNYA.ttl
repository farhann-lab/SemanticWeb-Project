wh:site_358 a wh:WorldHeritageSite ;
    rdfs:label "المسجد الكبير ومشفى ديوريجي"@ar,
        "Great Mosque and Hospital of Divriği"@en,
        "Gran mezquita y hospital de Divriği"@es,
        "Grande mosquée et hôpital de Divriği"@fr,
        "Большая мечеть и больница в городе Дивриги"@ru,
        "迪夫里伊的大清真寺和医院"@zh ;
    wh:areaHectares 0.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "This region of Anatolia was conquered by the Turks at the beginning of the 11th century. In 1228–29 Emir Ahmet Shah founded a mosque, with its adjoining hospital, at Divrigi. The mosque has a single prayer room and is crowned by two cupolas. The highly sophisticated technique of vault construction, and a creative, exuberant type of decorative sculpture – particularly on the three doorways, in contrast to the unadorned walls of the interior – are the unique features of this masterpiece of Islamic architecture."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_358 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_iv ;
    wh:hasImage wh:image_0d15d30b6b1d281c,
