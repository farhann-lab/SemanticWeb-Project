wh:site_294 a wh:WorldHeritageSite ;
    rdfs:label "بعلبك"@ar,
        "Baalbek"@en,
        "Baalbek"@es,
        "Baalbek"@fr,
        "Древний город Баальбек"@ru,
        "巴勒贝克"@zh ;
    wh:areaHectares 0.0 ;
    wh:belongsToRegion wh:region_ARB ;
    wh:description "This Phoenician city, where a triad of deities was worshipped, was known as Heliopolis during the Hellenistic period. It retained its religious function during Roman times, when the sanctuary of the Heliopolitan Jupiter attracted thousands of pilgrims. Baalbek, with its colossal structures, is one of the finest examples of Imperial Roman architecture at its apogee."@en ;
