    wh:description "Karlskrona is an outstanding example of a late-17th-century European planned naval city. The original plan and many of the buildings have survived intact, along with installations that illustrate its subsequent development up to the present day."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_871-001,
        wh:component_871-002,
        wh:component_871-003,
        wh:component_871-004,
