wh:site_932 a wh:WorldHeritageSite ;
    rdfs:label "ولاية سان إميليون"@ar,
        "Jurisdiction of Saint-Emilion"@en,
        "Jurisdicción de Saint-Emilion"@es,
        "Juridiction de Saint-Émilion"@fr,
        "Винодельческий район Сент-Эмильон"@ru,
        "圣艾米伦区"@zh ;
    wh:areaHectares 7847.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Viticulture was introduced to this fertile region of Aquitaine by the Romans, and intensified in the Middle Ages. The Saint-Emilion area benefited from its location on the pilgrimage route to Santiago de Compostela and many churches, monasteries and hospices were built there from the 11th century onwards. It was granted the special status of a 'jurisdiction' during the period of English rule in the 12th century. It is an exceptional landscape devoted entirely to wine-growing, with many fine historic monuments in its towns and villages."@en ;
