wh:site_975 a wh:WorldHeritageSite ;
    rdfs:label "المجمع الصناعي لاستخراج الفحم الحجري  في إيسين"@ar,
        "Zollverein Coal Mine Industrial Complex in Essen"@en,
        "Complejo industrial de la mina de carbón de Zollverein en Essen"@es,
        "Complexe industriel de la mine de charbon de Zollverein à Essen"@fr,
        "Старая угольная шахта Цольферайн в городе Эссен"@ru,
        "埃森的关税同盟煤矿工业区"@zh ;
    wh:areaHectares 0.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The Zollverein industrial complex in Land Nordrhein-Westfalen consists of the complete infrastructure of a historical coal-mining site, with some 20th-century buildings of outstanding architectural merit. It constitutes remarkable material evidence of the evolution and decline of an essential industry over the past 150 years."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_975 ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_iii ;
