wh:site_976 a wh:WorldHeritageSite ;
    rdfs:label "مناطق كيونغ جو التاريخية"@ar,
        "Gyeongju Historic Areas"@en,
        "Zonas históricas de Gyeongju"@es,
        "Zones historiques de Gyeongju"@fr,
        "Исторические территории Кёнджу"@ru,
        "庆州历史区"@zh ;
    wh:areaHectares 2880.0 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "The Gyeongju Historic Areas contain a remarkable concentration of outstanding examples of Korean Buddhist art, in the form of sculptures, reliefs, pagodas, and the remains of temples and palaces from the flowering, in particular between the 7th and 10th centuries, of this form of unique artistic expression."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_976-001,
        wh:component_976-002,
        wh:component_976-003,
        wh:component_976-004,
        wh:component_976-005 ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_iii ;
