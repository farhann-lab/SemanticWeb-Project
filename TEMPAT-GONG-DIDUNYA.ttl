wh:site_601 a wh:WorldHeritageSite ;
    rdfs:label "كاتدرائية نوتر دام، دير القديس ريمي القديم، قصر تو، وكاتدرائية ريمس"@ar,
        "Cathedral of Notre-Dame, Former Abbey of Saint-Rémi and Palace of Tau, Reims"@en,
        "Catedral de Notre-Dame, antigua abadía de Saint-Remi y palacio de Tau en Reims"@es,
        "Cathédrale Notre-Dame, ancienne abbaye Saint-Rémi et palais du Tau, Reims"@fr,
        "Кафедральный собор Нотр-Дам, бывший монастырь Сен-Реми и дворец То в городе Реймс"@ru,
        "兰斯圣母大教堂、圣雷米修道院和圣安东尼宫殿"@zh ;
    wh:areaHectares 4.16 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The outstanding handling of new architectural techniques in the 13th century, and the harmonious marriage of sculptural decoration with architecture, has made Notre-Dame in Reims one of the masterpieces of Gothic art. The former abbey still has its beautiful 9th-century nave, in which lie the remains of Archbishop St Rémi (440–533), who instituted the Holy Anointing of the kings of France. The former archiepiscopal palace known as the Tau Palace, which played an important role in religious ceremonies, was almost entirely rebuilt in the 17th century."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_601 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_ii ;
    wh:hasImage wh:image_02898633e5ac64cc,
        wh:image_1e105afe365f9c82,
        wh:image_25fd20d2e7ffc539,
        wh:image_2830e699ea49d344,
