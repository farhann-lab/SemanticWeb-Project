wh:site_1539 a wh:WorldHeritageSite ;
    rdfs:label "Tarnowskie Góry Lead-Silver-Zinc Mine and its Underground Water Management System"@en,
        "Mina de plomo, plata y zinc de Tarnowskie Góry y su sistema subterráneo de gestión hidráulica"@es,
        "Mine de plomb, argent et zinc de Tarnowskie Góry et son système de gestion hydraulique souterrain"@fr ;
    wh:areaHectares 1672.76 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Located in Upper Silesia, in southern Poland, one of the main mining areas of central Europe, the property includes the entire underground mine with adits, shafts, galleries and other features of the water management system. Most of the property is situated underground while the surface mining topography features relics of shafts and waste heaps, as well as the remains of the 19th century steam water pumping station. The elements of the water management system, located underground and on the surface, testify to continuous efforts over three centuries to drain the underground extraction zone and to use undesirable water from the mines to supply towns and industry. Tarnowskie Góry represents a significant contribution to the global production of lead and zinc."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1539 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_ii,
        wh:criterion_iv ;
    wh:hasImage wh:image_13773a22644d5ee7,
