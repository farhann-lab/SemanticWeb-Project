wh:site_332 a wh:WorldHeritageSite ;
    rdfs:label "مدينة كركوان البونيقية ومقبرتها"@ar,
        "Punic Town of Kerkuane and its Necropolis"@en,
        "Ciudad púnica de Kerkuán y su necrópolis"@es,
        "Cité punique de Kerkouane et sa nécropole"@fr,
        "Пунический город Керкуан и его некрополь"@ru,
        "科克瓦尼布尼城及其陵园"@zh ;
    wh:areaHectares 0.1119 ;
    wh:belongsToRegion wh:region_ARB ;
    wh:description "This Phoenician city was probably abandoned during the First Punic War (c. 250 B.C.) and as a result was not rebuilt by the Romans. The remains constitute the only example of a Phoenicio-Punic city to have survived. The houses were built to a standard plan in accordance with a sophisticated notion of town planning."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_332bis-001,
        wh:component_332bis-002 ;
    wh:hasCriterion wh:criterion_iii ;
