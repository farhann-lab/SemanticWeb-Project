    rdfs:label "Mount Kenya National Park/Natural Forest"@en,
        "Parque nacional/Bosque natural del Monte Kenya"@es,
        "Parc national/Forêt naturelle du mont Kenya"@fr ;
    wh:areaHectares 202334.0 ;
