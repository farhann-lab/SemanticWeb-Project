wh:site_1573 a wh:WorldHeritageSite ;
    rdfs:label "مبنى المفرى الملكي - القصر، الكنسية، الدير، حديقة سيركو، حديقة الصيد"@ar,
        "Royal Building of <i>Mafra</i> – Palace, Basilica, Convent, <i>Cerco</i> Garden and Hunting Park (<i>Tapada</i>)"@en,
        "Real Obra de Mafra – Palacio, basílica, convento, jardín del ‘Cerco’ y parque de caza real de la Tapada"@es,
        "Édifice royal de <i>Mafra</i> – palais, basilique, couvent, jardin du <i>Cerco</i> et parc de chasse (<i>Tapada</i>)"@fr,
        "Дворцовый ансамбль Мафра – дворец, базилика, монастырь, сад Cerco и охотничий парк Tapada"@ru,
        "马夫拉皇室建筑-宫殿、大教堂、修道院、塞尔科花园及塔帕达狩猎公园"@zh ;
    wh:areaHectares 1213.17 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Located 30 km northwest of Lisbon, the property was conceived by King João V in 1711 as a tangible representation of his conception of the monarchy and the State. This imposing quadrangular building houses the king’s and queen's palaces, the royal chapel, shaped like a Roman baroque basilica, a Franciscan monastery and a library containing 36,000 volumes. The complex is completed by the Cerco garden, with its geometric layout, and the royal hunting park (Tapada). The Royal Mafra Building is one of the most remarkable works undertaken by King João V, which illustrates the power and reach of the Portuguese Empire. João V adopted Roman and Italian baroque architectural and artistic models and commissioned works of art that make Mafra an exceptional example of Italian Baroque."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1573 ;
    wh:hasCriterion wh:criterion_iv ;
    wh:hasImage wh:image_08a037626da3c047,
        wh:image_0df86dc973c5132e,
        wh:image_101b8d4862ac40c2,
        wh:image_10c0527d0c7a1ebb,
