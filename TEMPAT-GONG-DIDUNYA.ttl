wh:site_116 a wh:WorldHeritageSite ;
    rdfs:label "مدن جنّة  القديمة"@ar,
        "Old Towns of Djenné"@en,
        "Ciudades antiguas de Djenné"@es,
        "Villes anciennes de Djenné"@fr,
        "Старые города Дженне"@ru,
        "杰内古城"@zh ;
    wh:areaHectares 0.0 ;
    wh:belongsToRegion wh:region_AFR ;
    wh:description "Inhabited since 250 B.C., Djenné became a market centre and an important link in the trans-Saharan gold trade. In the 15th and 16th centuries, it was one of the centres for the propagation of Islam. Its traditional houses, of which nearly 2,000 have survived, are built on hillocks (toguere) as protection from the seasonal floods."@en ;
