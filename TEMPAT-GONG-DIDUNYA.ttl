    rdfs:label "مرفأ كارلسكرونا  البحري"@ar,
        "Naval Port of Karlskrona"@en,
        "Puerto naval de Karlskrona"@es,
        "Port naval de Karlskrona"@fr,
        "Военно-морской порт Карлскруна"@ru,
        "卡尔斯克鲁纳军港"@zh ;
    wh:areaHectares 320.417 ;
