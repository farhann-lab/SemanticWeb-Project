    wh:uuid "eeef3fc7-219f-5903-a251-8accc3959941"^^xsd:string .

wh:site_345 a wh:WorldHeritageSite ;
    rdfs:label "مدينة كركاسون  التاريخية الحصينة"@ar,
        "Historic Fortified City of Carcassonne"@en,
        "Ciudad fortificada histórica de Carcasona"@es,
        "Ville fortifiée historique de Carcassonne"@fr,
        "Исторический укрепленный город Каркасон"@ru,
        "卡尔卡松历史城墙要塞"@zh ;
    wh:areaHectares 11.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Since the pre-Roman period, a fortified settlement has existed on the hill where Carcassonne now stands. In its present form it is an outstanding example of a medieval fortified town, with its massive defences encircling the castle and the surrounding buildings, its streets and its fine Gothic cathedral. Carcassonne is also of exceptional importance because of the lengthy restoration campaign undertaken by Viollet-le-Duc, one of the founders of the modern science of conservation."@en ;
