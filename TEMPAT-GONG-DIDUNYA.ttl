wh:site_1742 a wh:WorldHeritageSite ;
    rdfs:label "محمية العقبة البحرية"@ar,
        "Aqaba Marine Reserve"@en,
        "Reserva marina de Aqaba"@es,
        "Réserve marine d’Aqaba"@fr,
        "Морской заповедник Акаба"@ru,
        "亚喀巴海洋保护区"@zh ;
    wh:areaHectares 701.0 ;
    wh:belongsToRegion wh:region_ARB ;
    wh:description "The property, located at the northernmost tip of the Red Sea, comprises a mosaic of coral reefs, seagrass beds, and mesophotic reefs that sustain diverse marine life and ecological processes. Recognized as the world’s northernmost tropical coral reef system, the property is notable for its thermally resilient corals, which have adapted over the last 10,000 years to marine heatwaves, high salinity, and elevated summer temperatures. The reserve safeguards important marine genetic resources and supports exceptional biodiversity, including more than 150 species of hard coral, over 500 species of fish, and 1,000 species of molluscs. Its coral endemism is globally significant, supporting approximately 61% of all Red Sea endemic hard coral species, while more than 80 fish species are endemic to the Red Sea or Gulf of Aqaba."@en ;
    wh:hasCategory wh:category_Natural ;
    wh:hasComponent wh:component_1742 ;
    wh:hasCriterion wh:criterion_ix,
        wh:criterion_x ;
