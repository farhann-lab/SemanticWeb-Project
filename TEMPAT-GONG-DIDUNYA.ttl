wh:site_1224 a wh:WorldHeritageSite ;
    rdfs:label "معبد بريه فيهير"@ar,
        "Temple of Preah Vihear"@en,
        "Sitio sagrado del templo de Preah Vihear"@es,
        "Temple de Preah Vihear"@fr,
        "Храм Преах Вихеар"@ru ;
    wh:areaHectares 154.7 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "Situated on the edge of a plateau that dominates the plain of Cambodia, the Temple of Preah Vihear is dedicated to Shiva. The Temple is composed of a series of sanctuaries linked by a system of pavements and staircases over an 800 metre long axis and dates back to the first half of the 11th century AD. Nevertheless, its complex history can be traced to the 9th century, when the hermitage was founded. This site is particularly well preserved, mainly due to its remote location. The site is exceptional for the quality of its architecture, which is adapted to the natural environment and the religious function of the temple, as well as for the exceptional quality of its carved stone ornamentation."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1224rev ;
    wh:hasCriterion wh:criterion_i ;
    wh:hasImage wh:image_2448aec2993290ec,
        wh:image_26571981c985d7e8,
