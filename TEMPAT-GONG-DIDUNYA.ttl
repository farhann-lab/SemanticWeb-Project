wh:site_1483 a wh:WorldHeritageSite ;
    rdfs:label "حديقة سنغافورة النباتية"@ar,
        "Singapore Botanic Gardens"@en,
        "Jardín botánico de Singapur"@es,
        "Jardins botaniques de Singapour"@fr,
        "Ботанический сад Сингапура"@ru,
        "新加坡植物园"@zh ;
    wh:areaHectares 49.0 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "Situated at the heart of the city of Singapore, the site demonstrates the evolution of a British tropical colonial botanic garden that has become a modern world-class scientific institution used for both conservation and education. The cultural landscape includes a rich variety of historic features, plantings and buildings that demonstrate the development of the garden since its creation in 1859. It has been an important centre for science, research and plant conservation, notably in connection with the cultivation of rubber plantations, in Southeast Asia since 1875."@en ;
