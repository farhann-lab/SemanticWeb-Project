wh:site_603 a wh:WorldHeritageSite ;
    rdfs:label "سمرقند – ملتقى الثقافات"@ar,
        "Samarkand – Crossroad of Cultures"@en,
        "Samarcanda - Encrucijada de culturas"@es,
        "Samarkand – carrefour de cultures"@fr,
        "Самарканд – перекресток культур"@ru,
        "处在文化十字路口的撒马尔罕城"@zh ;
    wh:areaHectares 1123.0 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "The historic town of Samarkand is a crossroad and melting pot of the world's cultures. Founded in the 7th century B.C. as ancient Afrasiab, Samarkand had its most significant development in the Timurid period from the 14th to the 15th centuries. The major monuments include the Registan Mosque and madrasas, Bibi-Khanum Mosque, the Shakhi-Zinda compound and the Gur-Emir ensemble, as well as Ulugh-Beg's Observatory."@en ;
    wh:hasCategory wh:category_Cultural ;
