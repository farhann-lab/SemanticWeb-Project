wh:site_75 a wh:WorldHeritageSite ;
    rdfs:label "منتزه غراند كانيون الوطني"@ar,
        "Grand Canyon National Park"@en,
        "Parque Nacional del Gran Cañón"@es,
        "Parc national du Grand Canyon"@fr,
        "Национальный парк Гранд-Каньон"@ru,
        "大峡谷国家公园"@zh ;
    wh:areaHectares 493270.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Carved out by the Colorado River, the Grand Canyon (nearly 1,500 m deep) is the most spectacular gorge in the world. Located in the state of Arizona, it cuts across the Grand Canyon National Park. Its horizontal strata retrace the geological history of the past 2 billion years. There are also prehistoric traces of human adaptation to a particularly harsh environment."@en ;
