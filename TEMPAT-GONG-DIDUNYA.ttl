    rdfs:label "اوشفيتز بيركينو / معسكر الاعتقال والابادة النازي الالماني (1940 – 1945)"@ar,
        "Auschwitz Birkenau <br /><small>German Nazi Concentration and Extermination Camp (1940-1945)</small>"@en,
        "Auschwitz Birkenau Campo nazi alemán de concentración y exterminio (1940-1945)"@es,
        "Auschwitz Birkenau<br /><small>Camp allemand nazi de concentration et d'extermination (1940-1945)</small>"@fr,
