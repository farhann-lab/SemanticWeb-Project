wh:site_837 a wh:WorldHeritageSite ;
    rdfs:label "مدينة تطوان (قديمًا تيطاوين)"@ar,
        "Medina of Tétouan (formerly known as Titawin)"@en,
        "Medina de Tetuán (Antigua Titawin)"@es,
        "Médina de Tétouan (ancienne Titawin)"@fr,
        "Медина (старая часть) города Тетуан"@ru,
        "缔头万城"@zh ;
    wh:areaHectares 6.5 ;
    wh:belongsToRegion wh:region_ARB ;
    wh:description "Tétouan was of particular importance in the Islamic period, from the 8th century onwards, since it served as the main point of contact between Morocco and Andalusia. After the Reconquest, the town was rebuilt by Andalusian refugees who had been expelled by the Spanish. This is well illustrated by its art and architecture, which reveal clear Andalusian influence. Although one of the smallest of the Moroccan medinas, Tétouan is unquestionably the most complete and it has been largely untouched by subsequent outside influences."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_837 ;
