wh:site_1591 a wh:WorldHeritageSite ;
    rdfs:label "غيتبول، مسطحات المدِّ والجزر الكورية"@ar,
        "Getbol, Korean Tidal Flats"@en,
        "Getbol, planicie intermareal coreana"@es,
        "Getbol, étendues cotidales coréennes"@fr,
        "Гетбол, приливно-отливные равнины в Корее"@ru,
        "韩国滩涂"@zh ;
    wh:areaHectares 156386.0 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "The property comprises six component parts located along the southwestern, southern, and western coasts of the Republic of Korea on the eastern shore of the Yellow Sea. Originally inscribed in 2021 and extended in 2026, it encompasses a diverse system of tidal flat ecosystems, including estuarine, open-coast, archipelagic, and semi-enclosed tidal flats shaped by a complex combination of geological, oceanographic, and climatic conditions. These highly productive coastal wetlands support exceptional biodiversity, with 2,454 recorded plant and animal species, including a remarkable diversity of tidal-flat invertebrates and 53 species endemic to the Yellow Sea. Situated at the heart of the East Asian-Australasian Flyway, the property provides critical feeding, breeding, and stopover habitats for migratory waterbirds, supporting 216 bird species, including 24 globally threatened species and important populations of species such as the Spoon-billed Sandpiper, Far Eastern Curlew, and Black-faced Spoonbill. The property also supports 114 fish species, two species of marine mammals, and diverse communities of benthic diatoms, macroalgae, halophytes, and macrobenthos."@en ;
    wh:hasCategory wh:category_Natural ;
    wh:hasComponent wh:component_1591bis-001,
