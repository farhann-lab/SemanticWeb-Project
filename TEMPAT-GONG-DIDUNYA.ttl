wh:site_662 a wh:WorldHeritageSite ;
    rdfs:label "ياكوشيما"@ar,
        "Yakushima"@en,
        "Yakushima"@es,
        "Yakushima"@fr,
        "Остров Якусима"@ru,
        "屋久岛"@zh ;
    wh:areaHectares 10747.0 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "Located in the interior of Yaku Island, at the meeting-point of the palaearctic and oriental biotic regions, Yakushima exhibits a rich flora, with some 1,900 species and subspecies, including ancient specimens of the sugi (Japanese cedar). It also contains a remnant of a warm-temperate ancient forest that is unique in this region."@en ;
    wh:hasCategory wh:category_Natural ;
    wh:hasComponent wh:component_662 ;
    wh:hasCriterion wh:criterion_ix,
        wh:criterion_vii ;
    wh:hasImage wh:image_0c02223085326472,
