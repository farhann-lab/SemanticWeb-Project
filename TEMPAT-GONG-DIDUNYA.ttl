    wh:uuid "aa90b312-19ce-5892-b5f1-bfa8fca2bc1c"^^xsd:string .

wh:site_1195 a wh:WorldHeritageSite ;
    rdfs:label "زقاقان بحريّان غرب النروج، غيرانجرفيورد ونارويفيورد"@ar,
        "West Norwegian Fjords – Geirangerfjord and Nærøyfjord"@en,
        "Fiordos del oeste de Noruega – Geirangerfjord y Nærøyfjord"@es,
        "Fjords de l’Ouest de la Norvège – Geirangerfjord et Nærøyfjord"@fr,
