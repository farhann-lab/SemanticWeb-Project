    rdfs:label "مدينة الصويرة (قديمًا موغادور)"@ar,
        "Medina of Essaouira (formerly Mogador)"@en,
        "Medina de Esauira (Antigua Mogador)"@es,
        "Médina d’Essaouira (ancienne Mogador)"@fr,
