wh:site_1509 a wh:WorldHeritageSite ;
    rdfs:label "غابات شينونجيا في هوبي"@ar,
        "Hubei Shennongjia"@en,
        "Shennongjia de Hubei"@es,
        "Shennongjia au Hubei"@fr,
        "Шэньнунцзя в провинции Хубэй"@ru,
        "湖北神农架"@zh ;
    wh:areaHectares 79624.0 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "Located in Hubei Province, in central-eastern China, the site consists of two components: Shennongding/Badong to the west and Laojunshan to the east. It protects the largest primary forests remaining in Central China and provides habitat for many rare animal species, such as the Chinese Giant Salamander, the Golden or Sichuan Snub-nosed Monkey, the Clouded Leopard, Common Leopard and the Asian Black Bear. Hubei Shennongjia is one of three centres of biodiversity in China. The site features prominently in the history of botanical research and was the object of international plant collecting expeditions in the 19th and 20th centuries."@en ;
    wh:hasCategory wh:category_Natural ;
    wh:hasComponent wh:component_1509bis-001,
        wh:component_1509bis-002 ;
    wh:hasCriterion wh:criterion_ix,
        wh:criterion_x ;
    wh:hasImage wh:image_038b5e296b6fd8ed,
        wh:image_051f154f0f45fa0a,
        wh:image_0af7939292dba89e,
