    wh:belongsToRegion wh:region_EUR ;
    wh:description "The Royal Domain of Drottningholm stands on an island in Lake Mälar in a suburb of Stockholm. With its castle, perfectly preserved theatre (built in 1766), Chinese pavilion and gardens, it is the finest example of an 18th-century north European royal residence inspired by the Palace of Versailles."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_559bis ;
    wh:hasCriterion wh:criterion_iv ;
