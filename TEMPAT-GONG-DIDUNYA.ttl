wh:site_676 a wh:WorldHeritageSite ;
    rdfs:label "وسط زاكاتيكاس التاريخي"@ar,
        "Historic Centre of Zacatecas"@en,
        "Centro histórico de Zacatecas"@es,
        "Centre historique de Zacatecas"@fr,
        "Исторический центр города Сакатекас"@ru,
        "萨卡特卡斯历史中心"@zh ;
    wh:areaHectares 207.72 ;
    wh:belongsToRegion wh:region_LAC ;
    wh:description "Founded in 1546 after the discovery of a rich silver lode, Zacatecas reached the height of its prosperity in the 16th and 17th centuries. Built on the steep slopes of a narrow valley, the town has breathtaking views and there are many old buildings, both religious and civil. The cathedral, built between 1730 and 1760, dominates the centre of the town. It is notable for its harmonious design and the Baroque profusion of its façades, where European and indigenous decorative elements are found side by side."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_676 ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_iv ;
    wh:hasImage wh:image_0737d09217d020e6,
        wh:image_0f129161910a587c,
        wh:image_4ecf8bbed8bfc05d,
        wh:image_57273ea697545df8,
        wh:image_5f8e524a29c36f02,
