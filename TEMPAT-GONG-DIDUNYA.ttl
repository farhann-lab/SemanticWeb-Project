wh:site_149 a wh:WorldHeritageSite ;
    rdfs:label "منتزه كيريغوا الأثري وآثارها"@ar,
        "Archaeological Park and Ruins of Quirigua"@en,
        "Parque arqueológico y ruinas de Quiriguá"@es,
        "Parc archéologique et ruines de Quirigua"@fr,
        "Археологический парк и руины Киригуа"@ru,
        "基里瓜考古公园和玛雅文化遗址"@zh ;
    wh:areaHectares 34.0 ;
    wh:belongsToRegion wh:region_LAC ;
    wh:description "Inhabited since the 2nd century A.D., Quirigua had become during the reign of Cauac Sky (723–84) the capital of an autonomous and prosperous state. The ruins of Quirigua contain some outstanding 8th-century monuments and an impressive series of carved stelae and sculpted calendars that constitute an essential source for the study of Mayan civilization."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_149 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_ii,
        wh:criterion_iv ;
    wh:hasImage wh:image_274afc9235d4da28,
        wh:image_283c03f6e1fe5065,
        wh:image_2cc4e3e402a09afd,
        wh:image_31230e4cef445005,
