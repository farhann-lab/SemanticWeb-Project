wh:site_72 a wh:WorldHeritageSite ;
    rdfs:label "كلوين/ورانغل-سانت إلياس-خليج الكتل الجليدية/تاتشانشيني ألسيك"@ar,
        "Kluane / Wrangell-St. Elias / Glacier Bay / Tatshenshini-Alsek"@en,
        "Kluane / Wrangell-St. Elias / Bahí­a de los Glaciares / Tatshenshini-Alsek"@es,
        "Kluane / Wrangell-St. Elias / Glacier Bay / Tatshenshini-Alsek"@fr,
        "Парки и резерваты Клуэйн, Врангеля-Св.Ильи, Глейшер-Бей, Татшеншини-Алсек"@ru,
        "克卢恩/兰格尔-圣伊莱亚斯/冰川湾/塔琴希尼-阿尔塞克"@zh ;
    wh:areaHectares 9839121.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "These parks comprise an impressive complex of glaciers and high peaks on both sides of the border between Canada (Yukon Territory and British Columbia) and the United States (Alaska). The spectacular natural landscapes are home to many grizzly bears, caribou and Dall's sheep. The site contains the largest non-polar icefield in the world."@en ;
    wh:hasCategory wh:category_Natural ;
    wh:hasComponent wh:component_72ter ;
    wh:hasCriterion wh:criterion_ix,
        wh:criterion_vii,
        wh:criterion_viii,
        wh:criterion_x ;
    wh:hasImage wh:image_0b4eb184ba7ced8d,
        wh:image_345cb056998395c1,
        wh:image_35e376ab4738d8a9,
        wh:image_37787d97a9555297,
