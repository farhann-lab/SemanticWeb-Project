wh:site_635 a wh:WorldHeritageSite ;
    rdfs:label "كاتدرائية بورج"@ar,
        "Bourges Cathedral"@en,
        "Catedral de Bourges"@es,
        "Cathédrale de Bourges"@fr,
        "Кафедральный собор в городе Бурж"@ru,
        "布尔日大教堂"@zh ;
    wh:areaHectares 0.85 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The Cathedral of St Etienne of Bourges, built between the late 12th and late 13th centuries, is one of the great masterpieces of Gothic art and is admired for its proportions and the unity of its design. The tympanum, sculptures and stained-glass windows are particularly striking. Apart from the beauty of the architecture, it attests to the power of Christianity in medieval France."@en ;
