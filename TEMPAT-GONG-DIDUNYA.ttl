wh:site_505 a wh:WorldHeritageSite ;
    rdfs:label "دير ألكوباسا"@ar,
        "Monastery of Alcobaça"@en,
        "Monasterio de Alcobaça"@es,
        "Monastère d'Alcobaça"@fr,
        "Монастырь Алкобаса"@ru,
        "阿尔科巴萨修道院"@zh ;
    wh:areaHectares 0.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The Monastery of Santa Maria d'Alcobaça, north of Lisbon, was founded in the 12th century by King Alfonso I. Its size, the purity of its architectural style, the beauty of the materials and the care with which it was built make this a masterpiece of Cistercian Gothic art."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_505 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_iv ;
    wh:hasImage wh:image_06165888b13b3bab,
        wh:image_1bc1f815ab7f090f,
        wh:image_31713fbb4f416b50,
        wh:image_3e07d57196d70deb,
