wh:site_1293 a wh:WorldHeritageSite ;
    rdfs:label "الحجر (مدائن صالح)"@ar,
        "Hegra Archaeological Site (al-Hijr / Madā ͐ in Ṣāliḥ)"@en,
        "El sitio arqueológico de Al Hijr – Madain Salih"@es,
        "Site archéologique de Hegra (al-Hijr / Madā ͐ in Ṣāliḥ)"@fr,
        "Археологический объект Аль-Хиджр"@ru ;
    wh:areaHectares 1621.2 ;
    wh:belongsToRegion wh:region_ARB ;
    wh:description "The Hegra Archaeological Site (al-Hijr / Madā ͐ in Ṣāliḥ) is the first World Heritage property to be inscribed in Saudi Arabia. Formerly known as Hegra it is the largest conserved site of the civilization of the Nabataeans south of Petra in Jordan. It features well-preserved monumental tombs with decorated facades dating from the 1st century BC to the 1st century AD. The site also features some 50 inscriptions of the pre-Nabataean period and some cave drawings. Al-Hijr bears a unique testimony to Nabataean civilization. With its 111 monumental tombs, 94 of which are decorated, and water wells, the site is an outstanding example of the Nabataeans’ architectural accomplishment and hydraulic expertise."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1293 ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_iii ;
    wh:hasImage wh:image_117ffc39d9e0c31d,
        wh:image_19a00ab1f7c9f846,
        wh:image_1ad8ce9d529db8eb,
        wh:image_1d650287adc22295,
