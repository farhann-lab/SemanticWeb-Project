wh:site_1081 a wh:WorldHeritageSite ;
    rdfs:label "المنظر الثقافي لوادي اورخون"@ar,
        "Orkhon Valley Cultural Landscape"@en,
        "Paisaje cultural del valle del Orkhon"@es,
        "Paysage culturel de la vallée de l’Orkhon"@fr,
        "Культурный ландшафт долины реки Орхон"@ru,
        "鄂尔浑峡谷文化景观"@zh ;
    wh:areaHectares 121967.0 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "The 121,967-ha Orkhon Valley Cultural Landscape encompasses an extensive area of pastureland on both banks of the Orkhon River and includes numerous archaeological remains dating back to the 6th century. The site also includes Kharkhorum, the 13th- and 14th-century capital of Chingis (Genghis) Khan’s vast Empire. Collectively the remains in the site reflect the symbiotic links between nomadic, pastoral societies and their administrative and religious centres, and the importance of the Orkhon valley in the history of central Asia. The grassland is still grazed by Mongolian nomadic pastoralists."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1081rev ;
    wh:hasCriterion wh:criterion_ii,
