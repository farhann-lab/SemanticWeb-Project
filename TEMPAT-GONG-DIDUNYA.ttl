wh:site_144 a wh:WorldHeritageSite ;
    rdfs:label "آثار كيلوا كيسيواني وسونغو منارا"@ar,
        "Ruins of Kilwa Kisiwani and Ruins of Songo Mnara"@en,
        "Ruinas de Kilwa Kisiwani y Songo Mnara"@es,
        "Ruines de Kilwa Kisiwani et de Songo Mnara"@fr,
        "Руины Килва-Кисивани и Сонга-Манара"@ru,
        "基尔瓦基斯瓦尼遗址和松戈马拉遗址"@zh ;
    wh:areaHectares 0.0 ;
    wh:belongsToRegion wh:region_AFR ;
    wh:description "The remains of two great East African ports admired by early European explorers are situated on two small islands near the coast. From the 13th to the 16th century, the merchants of Kilwa dealt in gold, silver, pearls, perfumes, Arabian crockery, Persian earthenware and Chinese porcelain; much of the trade in the Indian Ocean thus passed through their hands."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_144-001,
        wh:component_144-002 ;
    wh:hasCriterion wh:criterion_iii ;
    wh:hasImage wh:image_03bb7b70eaee72fb,
        wh:image_128162da654312ba,
        wh:image_1851aeb4ea56161d,
        wh:image_1a56b38373bde54b,
