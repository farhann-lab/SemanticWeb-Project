wh:site_1572 a wh:WorldHeritageSite ;
    rdfs:label "غوبيكلي تيبي"@ar,
        "Göbekli Tepe"@en,
        "Göbekli Tepe"@es,
        "Göbekli Tepe"@fr,
        "Гёбекли-Тепе"@ru,
        "哥贝克力石阵"@zh ;
    wh:areaHectares 126.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Located in the Germuş mountains of south-eastern Anatolia, this property presents monumental round-oval and rectangular megalithic structures erected by hunter-gatherers in the Pre-Pottery Neolithic age between 9,600 and 8,200 BCE. These monuments were probably used in connection with rituals, most likely of a funerary nature. Distinctive T-shaped pillars are carved with images of wild animals, providing insight into the way of life and beliefs of people living in Upper Mesopotamia about 11,500 years ago."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1572 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_ii,
        wh:criterion_iv ;
