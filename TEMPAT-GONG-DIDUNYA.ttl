wh:site_316 a wh:WorldHeritageSite ;
    rdfs:label "كاتدرائيّة بورغوس"@ar,
        "Burgos Cathedral"@en,
        "Catedral de Burgos"@es,
        "Cathédrale de Burgos"@fr,
        "Кафедральный собор в городе Бургос"@ru,
        "布尔戈斯大教堂"@zh ;
    wh:areaHectares 1.03 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Our Lady of Burgos was begun in the 13th century at the same time as the great cathedrals of the Ile-de-France and was completed in the 15th and 16th centuries. The entire history of Gothic art is summed up in its superb architecture and its unique collection of works of art, including paintings, choir stalls, reredos, tombs and stained-glass windows."@en ;
