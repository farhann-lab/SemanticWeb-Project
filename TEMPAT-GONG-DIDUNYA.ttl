        wh:component_240-009,
        wh:component_240-010,
        wh:component_240-011,
        wh:component_240-012,
        wh:component_240-013,
        wh:component_240-014,
        wh:component_240-015 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_iii ;
    wh:hasImage wh:image_03966ece369904f0,
        wh:image_0849271b4d83dc93,
        wh:image_09c9851b58c39f98,
        wh:image_1bafb5a311c4ad2e,
        wh:image_26b7a16698dbe5e8,
