wh:site_1253 a wh:WorldHeritageSite ;
    rdfs:label "غامزيغراد- روموليانا، قصر غاليريوس"@ar,
        "Gamzigrad-Romuliana, Palace of Galerius"@en,
        "Gamzigrado-Romuliana – Palacio de Galerio"@es,
        "Gamzigrad-Romuliana, palais de Galère"@fr,
        "Дворец Галерия «Гамзиград-Ромулиана»"@ru,
        "贾姆济格勒－罗慕利亚纳的加莱里乌斯宫"@zh ;
    wh:areaHectares 179.217 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The Late Roman fortified palace compound and memorial complex of Gamzigrad-Romuliana, Palace of Galerius, in the east of Serbia, was commissioned by Emperor Caius Valerius Galerius Maximianus, in the late 3rd and early 4th centuries. It was known as Felix Romuliana, named after the emperor’s mother. The site consists of fortifications, the palace in the north-western part of the complex, basilicas, temples, hot baths, memorial complex, and a tetrapylon. The group of buildings is also unique in its intertwining of ceremonial and memorial functions."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1253 ;
    wh:hasCriterion wh:criterion_iii,
        wh:criterion_iv ;
    wh:hasImage wh:image_05fe6d2d0ac1bf38,
        wh:image_090a57d50d5fe8c8,
        wh:image_1fd1ea3ad671fd39,
