wh:site_285 a wh:WorldHeritageSite ;
    rdfs:label "مرفأ و حصون ومجموعة أثريّة- كارتاخينا"@ar,
        "Port, Fortresses and Group of Monuments, Cartagena"@en,
        "Puerto, fortalezas y conjunto monumental de Cartagena"@es,
        "Port, forteresses et ensemble monumental de Carthagène"@fr,
        "Порт, укрепления и памятники города Картахена"@ru,
        "卡塔赫纳港口、要塞和古迹群"@zh ;
    wh:areaHectares 0.0 ;
    wh:belongsToRegion wh:region_LAC ;
    wh:description "Situated in a bay in the Caribbean Sea, Cartagena has the most extensive fortifications in South America. A system of zones divides the city into three neighbourhoods: San Pedro, with the cathedral and many Andalusian-style palaces; San Diego, where merchants and the middle class lived; and Gethsemani, the 'popular quarter'."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_285 ;
    wh:hasCriterion wh:criterion_iv ;
    wh:hasImage wh:image_1e7b38560c1b4cdd,
        wh:image_4d902e85d461f6dc,
        wh:image_54b6c271b2464c40,
        wh:image_6cbe7140147a7c74,
