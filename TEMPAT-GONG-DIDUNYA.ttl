wh:site_1040 a wh:WorldHeritageSite ;
    rdfs:label "مصعدة"@ar,
        "Masada"@en,
        "Masada"@es,
        "Masada"@fr,
        "Древняя крепость Масада"@ru,
        "马萨达"@zh ;
    wh:areaHectares 276.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Masada is a rugged natural fortress, of majestic beauty, in the Judaean Desert overlooking the Dead Sea. It is a symbol of the ancient kingdom of Israel, its violent destruction and the last stand of Jewish patriots in the face of the Roman army, in 73 A.D. It was built as a palace complex, in the classic style of the early Roman Empire, by Herod the Great, King of Judaea, (reigned 37 – 4 B.C.). The camps, fortifications and attack ramp that encircle the monument constitute the most complete Roman siege works surviving to the present day."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1040 ;
    wh:hasCriterion wh:criterion_iii,
