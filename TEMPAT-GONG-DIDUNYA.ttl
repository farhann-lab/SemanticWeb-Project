    rdfs:label "الحيّ التاريخي لمدينة فال براييسو البحرية"@ar,
        "Historic Quarter of the Seaport City of Valparaíso"@en,
        "Barrio histórico de la ciudad portuaria de Valparaíso"@es,
        "Quartier historique de la ville portuaire de Valparaiso"@fr,
        "Историческая часть портового города Вальпараисо"@ru,
        "瓦尔帕莱索港口城市历史区"@zh ;
    wh:areaHectares 23.2 ;
    wh:belongsToRegion wh:region_LAC ;
    wh:description "The colonial city of Valparaíso presents an excellent example of late 19th-century urban and architectural development in Latin America. In its natural amphitheatre-like setting, the city is characterized by a vernacular urban fabric adapted to the hillsides that are dotted with a great variety of church spires. It contrasts with the geometrical layout utilized in the plain. The city has well preserved its interesting early industrial infrastructures, such as the numerous ‘elevators’ on the steep hillsides."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_959rev ;
    wh:hasCriterion wh:criterion_iii ;
