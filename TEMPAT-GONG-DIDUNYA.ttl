    rdfs:label "جزر نيوزيلندا القريبة من القطب الجنوبي"@ar,
        "New Zealand Sub-Antarctic Islands"@en,
        "Islas subantárticas de Nueva Zelandia"@es,
        "Îles sub-antarctiques de Nouvelle-Zélande"@fr,
        "Субантарктические острова"@ru,
