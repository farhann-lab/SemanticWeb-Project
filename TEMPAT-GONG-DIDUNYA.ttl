wh:site_1009 a wh:WorldHeritageSite ;
    rdfs:label "كاثدرائية سيدة تورنيه"@ar,
        "Notre-Dame Cathedral in Tournai"@en,
        "Catedral de Nuestra Señora de Tournai"@es,
        "Cathédrale Notre-Dame de Tournai"@fr,
        "Кафедральный собор Нотр-Дам в городе Турне"@ru,
        "图尔奈圣母大教堂"@zh ;
    wh:areaHectares 0.4963 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The Cathedral of Notre-Dame in Tournai was built in the first half of the 12th century. It is especially distinguished by a Romanesque nave of extraordinary dimensions, a wealth of sculpture on its capitals and a transept topped by five towers, all precursors of the Gothic style. The choir, rebuilt in the 13th century, is in the pure Gothic style."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1009 ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_iv ;
    wh:hasImage wh:image_0cca118bc7f377d9,
        wh:image_2095b42c474858f6,
        wh:image_21290093afa1a8d0,
        wh:image_380393e7ef565eba,
        wh:image_386bbdef38883d1c,
        wh:image_46b8d2e66584e51c,
        wh:image_591d31974bef36dd,
        wh:image_5ae15d1fb86761c2,
