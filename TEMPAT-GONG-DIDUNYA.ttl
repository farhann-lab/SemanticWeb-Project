wh:site_1503 a wh:WorldHeritageSite ;
    rdfs:label "نان مادول: موقع احتفالي في ميكرونيزيا الشرقية"@ar,
        "Nan Madol: Ceremonial Centre of Eastern Micronesia"@en,
        "Nan Madol: Ceremonial Centre of Eastern Micronesia"@es,
        "Nan Madol : centre cérémoniel de la Micronésie orientale"@fr,
        "Нан-Мадол: религиозно-культовый центр Восточной Микронезии"@ru,
        "南马都尔：东密克罗尼西亚庆典中心"@zh ;
    wh:areaHectares 76.7 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "Nan Madol is a series of more than 100 islets off the south-east coast of Pohnpei that were constructed with walls of basalt and coral boulders. These islets harbour the remains of stone palaces, temples, tombs and residential domains built between 1200 and 1500 CE. These ruins represent the ceremonial centre of the Saudeleur dynasty, a vibrant period in Pacific Island culture. The huge scale of the edifices, their technical sophistication and the concentration of megalithic structures bear testimony to complex social and religious practices of the island societies of the period. The site was also inscribed on the List of World Heritage in Danger due to threats, notably the siltation of waterways that is contributing to the unchecked growth of mangroves and undermining existing edifices."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1503 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_iii,
        wh:criterion_iv ;
