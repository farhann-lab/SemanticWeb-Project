        wh:component_1506-010,
        wh:component_1506-011 ;
    wh:hasCriterion wh:criterion_iii,
        wh:criterion_iv ;
    wh:hasImage wh:image_03892b8cd557ded4,
        wh:image_0c4e4b721adfe612,
        wh:image_134e73463030b3da,
        wh:image_16dd41b15432d3e5,
        wh:image_1997af82c44f9d16,
        wh:image_1d8a7acc06f014eb,
