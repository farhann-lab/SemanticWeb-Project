    rdfs:label "غابات الأمطار غوندوانا  في اوستراليا"@ar,
        "Gondwana Rainforests of Australia"@en,
        "Bosques lluviosos del Gondwana de Australia"@es,
        "Forêts humides Gondwana de l’Australie"@fr,
        "Дождевые леса восточного побережья"@ru,
