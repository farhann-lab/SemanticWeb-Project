wh:site_1067 a wh:WorldHeritageSite ;
    rdfs:label "سترالسوند وفيسمار التاريخيتان"@ar,
        "Historic Centres of Stralsund and Wismar"@en,
        "Centros históricos de Stralsund y Wismar"@es,
        "Centres historiques de Stralsund et Wismar"@fr,
        "Исторические центры городов Штральзунд и Висмар"@ru,
        "施特拉尔松德与维斯马历史中心"@zh ;
    wh:areaHectares 168.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The medieval towns of Wismar and Stralsund, on the Baltic coast of northern Germany, were major trading centres of the Hanseatic League in the 14th and 15th centuries. In the 17th and 18th centuries they became Swedish administrative and defensive centres for the German territories. They contributed to the development of the characteristic building types and techniques of Brick Gothic in the Baltic region, as exemplified in several important brick cathedrals, the Town Hall of Stralsund, and the series of houses for residential, commercial and crafts use, representing its evolution over several centuries."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1067-001,
        wh:component_1067-002 ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_iv ;
    wh:hasImage wh:image_03f82ddb4ebd8c86,
        wh:image_084c2050f6169c7b,
        wh:image_0a9ba94f1ea055fb,
