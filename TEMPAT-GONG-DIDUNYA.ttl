wh:site_1692 a wh:WorldHeritageSite ;
    rdfs:label "الكارست والكهوف المتشكلة بفعل التبخر في جبال الأبينيني الشمالية"@ar,
        "Evaporitic Karst and Caves of Northern Apennines"@en,
        "Karst evaporítico y cuevas en los Apeninos septentrionales"@es,
        "Karst et grottes évaporitiques de l’Apennin du Nord"@fr,
        "Эвапоритовый карст и пещеры Северных Апеннин"@ru,
        "北亚平宁的蒸发喀斯特和洞穴"@zh ;
    wh:areaHectares 3680.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "This serial property is an unusually well-preserved and extensive epigenic gypsum karst terrain. It includes a very high density of caves: over 900 caves in a relatively small area, with over 100 km of caves in total. It is the first and the best studied evaporitic karst in the world, with academic work beginning in the 16th century. It also includes some of the deepest gypsum caves in existence, reaching 265 meters below the surface."@en ;
    wh:hasCategory wh:category_Natural ;
