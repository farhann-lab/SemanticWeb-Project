wh:site_967 a wh:WorldHeritageSite ;
    rdfs:label "المنتزه الوطني نويل كمبف ميركادو"@ar,
        "Noel Kempff Mercado National Park"@en,
        "Parque Nacional Noel Kempff Mercado"@es,
        "Parc national Noel Kempff Mercado"@fr,
        "Национальный парк Ноэль-Кемпфф-Меркадо"@ru,
        "挪尔•肯普夫墨卡多国家公园"@zh ;
    wh:areaHectares 1523446.0 ;
    wh:belongsToRegion wh:region_LAC ;
    wh:description "The National Park is one of the largest (1,523,000 ha) and most intact parks in the Amazon Basin. With an altitudinal range of 200 m to nearly 1,000 m, it is the site of a rich mosaic of habitat types from Cerrado savannah and forest to upland evergreen Amazonian forests. The park boasts an evolutionary history dating back over a billion years to the Precambrian period. An estimated 4,000 species of flora as well as over 600 bird species and viable populations of many globally endangered or threatened vertebrate species live in the park."@en ;
    wh:hasCategory wh:category_Natural ;
    wh:hasComponent wh:component_967 ;
    wh:hasCriterion wh:criterion_ix,
        wh:criterion_x ;
    wh:hasMainImage wh:image_9440da3ea9c6739f ;
    wh:inscriptionYear "2000"^^xsd:gYear ;
    wh:isInDanger false ;
    wh:isTransboundary false ;
    wh:locatedIn wh:country_BO ;
    wh:shortDescription "The National Park is one of the largest (1,523,000 ha) and most intact parks in the Amazon Basin. With an altitudinal range of 200 m to nearly 1,000 m, it is the site of a rich mosaic of habitat types from Cerrado savannah and forest to upland evergreen Amazonian forests. The park boasts an evolutionary history dating back over a billion years to the Precambrian period. An estimated 4,000 species of flora as well as over 600 bird species and viable populations of many globally endangered or threatened vertebrate species live in the park."@en ;
