wh:site_516 a wh:WorldHeritageSite ;
    rdfs:label "صخور باندياغارا (بلاد الدوغون)"@ar,
        "Cliff of Bandiagara (Land of the Dogons)"@en,
        "Farallones de Bandiagara (País de los dogones)"@es,
        "Falaises de Bandiagara (pays dogon)"@fr,
        "Нагорье Бандиагара (земля догонов)"@ru,
        "邦贾加拉悬崖(多贡斯土地)"@zh ;
    wh:areaHectares 327390.0 ;
    wh:belongsToRegion wh:region_AFR ;
    wh:description "The Bandiagara site is an outstanding landscape of cliffs and sandy plateaux with some beautiful architecture (houses, granaries, altars, sanctuaries and Togu Na, or communal meeting-places). Several age-old social traditions live on in the region (masks, feasts, rituals, and ceremonies involving ancestor worship). The geological, archaeological and ethnological interest, together with the landscape, make the Bandiagara plateau one of West Africa's most impressive sites."@en ;
    wh:hasCategory wh:category_Mixed ;
    wh:hasComponent wh:component_516-001,
        wh:component_516-002 ;
    wh:hasCriterion wh:criterion_v,
        wh:criterion_vii ;
    wh:hasImage wh:image_09ed4f2be35d89da,
