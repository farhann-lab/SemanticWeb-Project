wh:site_826 a wh:WorldHeritageSite ;
    rdfs:label "بورتوفينيري، تشينكي تيرّي  والجزر (بالماريا، وتينو وتينيتّو)"@ar,
        "Portovenere, Cinque Terre, and the Islands (Palmaria, Tino and Tinetto)"@en,
