wh:site_115 a wh:WorldHeritageSite ;
    rdfs:label "ميدان الإمام، أصفهان"@ar,
        "Meidan Emam, Esfahan"@en,
        "Meidan Emam (Ispahán)"@es,
        "Meidan Emam, Ispahan"@fr,
        "Площадь Мейдан-Имам в городе Исфахан"@ru,
        "伊斯法罕王侯广场"@zh ;
    wh:areaHectares 13.0 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "Built by Shah Abbas I the Great at the beginning of the 17th century, and bordered on all sides by monumental buildings linked by a series of two-storeyed arcades, the site is known for the Royal Mosque, the Mosque of Sheykh Lotfollah, the magnificent Portico of Qaysariyyeh and the 15th-century Timurid palace. They are an impressive testimony to the level of social and cultural life in Persia during the Safavid era."@en ;
