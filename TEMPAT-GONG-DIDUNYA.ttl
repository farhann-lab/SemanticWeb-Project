wh:site_401 a wh:WorldHeritageSite ;
    rdfs:label "هولوكو، القرية القديمة ومحيطها"@ar,
        "Old Village of Hollókő and its Surroundings"@en,
        "Aldea antigua de Hollókö y sus alrededores"@es,
        "Hollókő, le vieux village et son environnement"@fr,
        "Историческое село Холлокё и его окружение"@ru,
        "霍洛克古村落及其周边"@zh ;
    wh:areaHectares 144.5 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Hollokö is an outstanding example of a deliberately preserved traditional settlement. This village, which developed mainly during the 17th and 18th centuries, is a living example of rural life before the agricultural revolution of the 20th century."@en ;
