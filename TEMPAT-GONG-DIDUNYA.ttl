wh:site_931 a wh:WorldHeritageSite ;
    rdfs:label "مدينة غراتس ـ المركز التاريخي وقصر إغّنبرج"@ar,
        "City of Graz – Historic Centre and Schloss Eggenberg"@en,
        "Centro histórico de la ciudad de Graz y palacio de Eggenberg"@es,
        "Ville de Graz – Centre historique et château d’Eggenberg"@fr,
        "Город Грац – исторический центр и замок Еггенберг"@ru,
        "格拉茨城历史中心与埃根博格城堡"@zh ;
    wh:areaHectares 91.094 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The City of Graz – Historic Centre and Schloss Eggenberg bear witness to an exemplary model of the living heritage of a central European urban complex influenced by the secular presence of the Habsburgs and the cultural and artistic role played by the main aristocratic families. They are a harmonious blend of the architectural styles and artistic movements that have succeeded each other from the Middle Ages until the 18th century, from the many neighbouring regions of Central and Mediterranean Europe. They embody a diversified and highly comprehensive ensemble of architectural, decorative and landscape examples of these interchanges of influence."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_931-001,
        wh:component_931bis-002 ;
