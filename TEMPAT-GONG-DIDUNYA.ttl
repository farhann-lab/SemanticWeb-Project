wh:site_1571 a wh:WorldHeritageSite ;
    rdfs:label "<تلال بروسيكو دي كونجليانو وفالدوبياديني"@ar,
        "Le Colline del Prosecco di Conegliano e Valdobbiadene"@en,
        "Colinas de vides del prosecco de Conegliano y Valdobbiadene"@es,
        "Les Collines du Prosecco de Conegliano et Valdobbiadene"@fr,
        "Холмы Просекко в Конельяно и Вальдоббьядене"@ru,
        "科内利亚诺和瓦尔多比亚德内的普罗赛柯产地"@zh ;
    wh:areaHectares 20334.2 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Located in north-eastern Italy, the property includes part of the winegrowing landscape of the Prosecco wine production area. The landscape is characterized by ‘hogback’ hills, ciglioni – small plots of vines on narrow grassy terraces – forests, small villages and farmland. For centuries, this rugged terrain has been shaped and adapted by man. Since the 17th century, the use of ciglioni has created a particular chequerboard landscape consisting of rows of vines parallel and vertical to the slopes. In the 19th century, the bellussera technique of training the vines contributed to the aesthetic characteristics of the landscape."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1571rev ;
    wh:hasCriterion wh:criterion_v ;
    wh:hasImage wh:image_55e0e06c2df4ffc0,
        wh:image_620c2c366c661f37,
        wh:image_6290b2db68d03934,
        wh:image_6698124e274280d0,
