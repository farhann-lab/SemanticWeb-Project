    wh:hasCriterion wh:criterion_viii ;
    wh:hasImage wh:image_0201ed67a54f0f5a,
        wh:image_11dab85d79ccb559,
        wh:image_581356e374cee38a,
        wh:image_6f89c17600588dca,
        wh:image_72d753b1175f0788,
        wh:image_8c79b774f54edf5f,
        wh:image_9ca47f78c0854a22,
        wh:image_b06efe3ab134180c,
        wh:image_b610387685402647,
        wh:image_b9c37ccfaa5ce726,
        wh:image_cd66b709c92cdca5,
        wh:image_ee18c401060a8e86 ;
