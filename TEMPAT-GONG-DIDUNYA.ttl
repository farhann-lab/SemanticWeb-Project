wh:site_113 a wh:WorldHeritageSite ;
    rdfs:label "تشوغا زنبيل"@ar,
        "Tchogha Zanbil"@en,
        "Tchogha Zanbil"@es,
        "Tchoga Zanbil"@fr,
        "Древний город Чога-Занбиль"@ru,
