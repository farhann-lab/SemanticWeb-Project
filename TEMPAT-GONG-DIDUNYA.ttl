wh:site_1724 a wh:WorldHeritageSite ;
    rdfs:label "وادي الوريعة"@ar,
        "Wadi Wurayah"@en,
        "Wadi Wurayah"@es,
        "Wadi Wurayah"@fr,
        "Вади-Вурайя"@ru,
        "瓦迪乌拉亚"@zh ;
    wh:areaHectares 22000.0 ;
    wh:belongsToRegion wh:region_ARB ;
    wh:description "The property is located entirely within the Hajar mountain range in the Emirate of Fujairah. Geologically, the Hajar Mountains represent extensive and well-preserved exposures of ophiolite sequences, formed during Late Cretaceous tectonic processes. Ecologically, the property is situated within the Al Hajar Foothill Xeric Woodlands and Shrublands, recognised for its ecological distinctiveness, high species richness, and significant levels of endemism. Wadi Wurayah hosts 1,099 recorded species (883 fauna and 216 flora), including at least ten globally threatened species. These represent approximately half of the terrestrial mammal species and nearly half of the terrestrial reptile species recorded in the country."@en ;
    wh:hasCategory wh:category_Natural ;
    wh:hasComponent wh:component_1724 ;
