    wh:areaHectares 4689.25 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The Ligurian coast between Cinque Terre and Portovenere is a cultural landscape of great scenic and cultural value. The layout and disposition of the small towns and the shaping of the surrounding landscape, overcoming the disadvantages of a steep, uneven terrain, encapsulate the continuous history of human settlement in this region over the past millennium."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_826bis-001,
        wh:component_826bis-002,
        wh:component_826bis-003,
        wh:component_826bis-004 ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_iv,
        wh:criterion_v ;
    wh:hasImage wh:image_15e2a68e0d09e828,
        wh:image_1b3268ff570c7ab9,
        wh:image_2ac807ab087c2282,
