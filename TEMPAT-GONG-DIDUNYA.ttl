    wh:belongsToRegion wh:region_ARB ;
    wh:description "Bosra, once the capital of the Roman province of Arabia, was an important stopover on the ancient caravan route to Mecca. A magnificent 2nd-century Roman theatre, early Christian ruins and several mosques are found within its great walls."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_22bis-001,
        wh:component_22bis-002 ;
    wh:hasCriterion wh:criterion_i,
