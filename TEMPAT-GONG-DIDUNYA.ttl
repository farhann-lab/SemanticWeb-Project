wh:site_303 a wh:WorldHeritageSite ;
    rdfs:label "منتزه إيغوازو  الوطني"@ar,
        "Iguazu National Park"@en,
        "Parque nacional del Iguazú"@es,
        "Parc national de l'Iguazu"@fr,
        "Национальный парк Игуасу"@ru,
        "伊瓜苏国家公园"@zh ;
    wh:areaHectares 55000.0 ;
    wh:belongsToRegion wh:region_LAC ;
    wh:description "The semicircular waterfall at the heart of this site is some 80 m high and 2,700 m in diameter and is situated on a basaltic line spanning the border between Argentina and Brazil. Made up of many cascades producing vast sprays of water, it is one of the most spectacular waterfalls in the world. The surrounding subtropical rainforest has over 2,000 species of vascular plants and is home to the typical wildlife of the region: tapirs, giant anteaters, howler monkeys, ocelots, jaguars and caymans."@en ;
    wh:hasCategory wh:category_Natural ;
    wh:hasComponent wh:component_303 ;
    wh:hasCriterion wh:criterion_vii,
        wh:criterion_x ;
    wh:hasImage wh:image_02f91c9ba1a0bc5e,
        wh:image_0b9c24f99ffb418c,
        wh:image_2cc6540816f38b3d,
