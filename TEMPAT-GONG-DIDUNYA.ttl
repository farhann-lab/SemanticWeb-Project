    wh:hasCriterion wh:criterion_iii,
        wh:criterion_v ;
    wh:hasImage wh:image_29e034b808fc5332,
        wh:image_463fd3d3a5d0f32c,
        wh:image_51ee72d0061b348f,
        wh:image_56d11ec03ac91734,
        wh:image_5f11e5e09dc94eac,
