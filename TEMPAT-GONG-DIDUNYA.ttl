wh:site_148 a wh:WorldHeritageSite ;
    rdfs:label "مدينة القدس القديمة وأسوارها"@ar,
        "Old City of Jerusalem and its Walls"@en,
        "Ciudad vieja de Jerusalén y sus murallas"@es,
        "Vieille ville de Jérusalem et ses remparts"@fr,
        "Старый город в Иерусалиме и его крепостные стены (объект предложен Иорданией)"@ru,
        "耶路撒冷古城及其城墙"@zh ;
    wh:areaHectares 0.0 ;
    wh:belongsToRegion wh:region_ARB ;
    wh:description "As a holy city for Judaism, Christianity and Islam, Jerusalem has always been of great symbolic importance. Among its 220 historic monuments, the Dome of the Rock stands out: built in the 7th century, it is decorated with beautiful geometric and floral motifs. It is recognized by all three religions as the site of Abraham's sacrifice. The Wailing Wall delimits the quarters of the different religious communities, while the Resurrection rotunda in the Church of the Holy Sepulchre houses Christ's tomb."@en ;
