wh:site_174 a wh:WorldHeritageSite ;
    rdfs:label "وسط فلورنسا التاريخي"@ar,
        "Historic Centre of Florence"@en,
        "Centro histórico de Florencia"@es,
        "Centre historique de Florence"@fr,
        "Исторический центр Флоренции"@ru,
        "佛罗伦萨历史中心"@zh ;
    wh:areaHectares 532.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Built on the site of an Etruscan settlement, Florence, the symbol of the Renaissance, rose to economic and cultural pre-eminence under the Medici in the 15th and 16th centuries. Its 600 years of extraordinary artistic activity can be seen above all in the 13th-century cathedral (Santa Maria del Fiore), the Church of Santa Croce, the Uffizi and the Pitti Palace, the work of great masters such as Giotto, Brunelleschi, Botticelli and Michelangelo."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_174quater ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_ii,
        wh:criterion_iii,
        wh:criterion_iv ;
