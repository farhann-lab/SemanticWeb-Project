wh:site_1762 a wh:WorldHeritageSite ;
    rdfs:label "منظومة المسارح الإيطالية ذات نظام الملكية المشتركة"@ar,
        "The system of Italian-style <em>condominio</em> theatres of the 18th and 19th centuries in Central Italy"@en,
        "El sistema de teatros en condominio a la italiana de los siglos XVIII y XIX en Italia central"@es,
        "Le système des théâtres à l’italienne en <em>condominio</em> des XVIIIe et XIXe siècles en Italie centrale"@fr,
        "Система итальянских театров condominio XVIII и XIX века в Центральной Италии"@ru,
        "意大利式共管剧院体系"@zh ;
    wh:areaHectares 4.42 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The serial property comprises ten Italian‑style condominio theatres built between the mid‑18th and late 19th centuries across Emilia‑Romagna, Marche, and Umbria in central Italy. Architecturally representative of Neoclassicism with Late Baroque influences, these theatres feature tiered boxes, carefully designed auditoriums for optimal acoustics and visibility, stalls, foyers, ridotti, and historic stage machinery. They embody the innovative “condominio” system, a model of collective ownership and public‑private financing that enabled municipalities and private citizens to collaborate in constructing theatres in small and medium‑sized towns. This system fostered the growth of a widespread cultural network, providing new representational spaces for the emerging bourgeoisie and broadening public access to the performing arts. Located at the heart of historic town centres, these theatres became important civic meeting places, hosting performances and public events and contributing to the formation of public opinion."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1762-001,
        wh:component_1762-002,
        wh:component_1762-003,
        wh:component_1762-004,
