wh:site_1761 a wh:WorldHeritageSite ;
    rdfs:label "وات فرا ماهاتات ووراماهاويهان، محافظة ناخون سي تامارات"@ar,
        "Wat Phra Mahathat Woramahawihan, Nakhon Si Thammarat"@en,
        "Wat Phra Mahathat Woramahawihan, Nakhon Si Thammarat"@es,
        "Wat Phra Mahathat Woramahawihan, Nakhon Si Thammarat"@fr,
        "Ват-Пхра-Махатхат-Ворамахавихан, Накхонситхаммарат"@ru,
        "洛坤府的玛哈泰寺"@zh ;
    wh:areaHectares 5.356 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "Wat Phra Mahathat Woramahawihan (or Phra Mahathat monastery), located in Nakhon Si Thammarat Province in Peninsular Thailand on a narrow ridge between the Pacific and Indian oceans, has served as a major regional Buddhist centre since its founding in the 8th century. Benefiting from the transoceanic trade networks, the monastery was influenced by various religious and architectural traditions including Brahmanism, Hinduism, Mahayana Buddhism and Theravada Buddhism from northeastern India, central Java, Sri Lanka and the Mon region of southern Myanmar. These influences have been integrated into its religious buildings, rituals and cultural traditions. Its distinctive artistic and architectural expressions have exerted a wide-ranging and enduring influence throughout Thailand and across Southeast Asia. The religious and local traditions have continued at the monastery for more than 1,500 years, including the Nakhon Si Thammarat chronicle tradition, the annual cloth-wrapping ceremony for the Great Reliquary and the Nora dance drama."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1761 ;
    wh:hasCriterion wh:criterion_ii ;
    wh:hasImage wh:image_33c6742facc109af,
        wh:image_4ed544b2c90620f7,
        wh:image_50cde93218d2a199,
        wh:image_5387b11fdfa824b5,
        wh:image_53e5cad278eed269,
