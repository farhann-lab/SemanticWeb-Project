    rdfs:label "ترينيداد ووادي لوس إنجينوس"@ar,
        "Trinidad and the Valley de los Ingenios"@en,
        "Trinidad y Valle de los Ingenios"@es,
        "Trinidad et la vallée de Los Ingenios"@fr,
        "Город Тринидад и долина Де-лос-Инхеньос"@ru,
        "特立尼达和洛斯因赫尼奥斯山谷"@zh ;
