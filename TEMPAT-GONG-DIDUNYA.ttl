wh:site_380 a wh:WorldHeritageSite ;
    rdfs:label "منتزه غاراخوناي الوطني"@ar,
        "Garajonay National Park"@en,
        "Parque Nacional de Garajonay"@es,
        "Parc national de Garajonay"@fr,
        "Национальный парк Гарахонай (Канарские острова)"@ru,
        "加拉霍艾国家公园"@zh ;
    wh:areaHectares 3984.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Laurel forest covers some 70% of this park, situated in the middle of the island of La Gomera in the Canary Islands archipelago. The presence of springs and numerous streams assures a lush vegetation resembling that of the Tertiary, which, due to climatic changes, has largely disappeared from southern Europe."@en ;
    wh:hasCategory wh:category_Natural ;
    wh:hasComponent wh:component_380 ;
    wh:hasCriterion wh:criterion_ix,
        wh:criterion_vii ;
    wh:hasImage wh:image_0395003bcf8e6e08,
        wh:image_26bd7df569dab69e,
        wh:image_416999004c758edd,
        wh:image_41d11b047e22710e,
