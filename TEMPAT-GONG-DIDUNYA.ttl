wh:site_173 a wh:WorldHeritageSite ;
    rdfs:label "مدينة زنجبار  الحجرية"@ar,
        "Stone Town of Zanzibar"@en,
        "Ciudad de piedra de Zanzíbar"@es,
        "La ville de pierre de Zanzibar"@fr,
        "«Каменный город» в Занзибаре"@ru,
        "桑给巴尔石头城"@zh ;
    wh:areaHectares 96.0 ;
    wh:belongsToRegion wh:region_AFR ;
    wh:description "The Stone Town of Zanzibar is a fine example of the Swahili coastal trading towns of East Africa. It retains its urban fabric and townscape virtually intact and contains many fine buildings that reflect its particular culture, which has brought together and homogenized disparate elements of the cultures of Africa, the Arab region, India, and Europe over more than a millennium."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_173rev ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_iii ;
    wh:hasImage wh:image_08419fd537475f66,
        wh:image_16146e9d8d56ae68,
        wh:image_175d374ca05f713b,
        wh:image_2e3d27255395a2e2,
        wh:image_2f1f53f8161bf9e9,
        wh:image_37b82b3cdfe1f7e3,
        wh:image_3bf0db6a14e6e52f,
        wh:image_4218323381ab144f,
        wh:image_46a720309e241c95,
        wh:image_4776778073412038,
        wh:image_4932eb832083ed75,
        wh:image_4a0b092c55619f34,
        wh:image_4b957ae308b0edf4,
        wh:image_4e6c01afd7dae242,
        wh:image_561f17e9571152e0,
        wh:image_5ffabe4401638c1e,
        wh:image_662bed1ba5f156bd,
        wh:image_689959750e32a600,
        wh:image_78a5571e75a54426,
