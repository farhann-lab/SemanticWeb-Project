wh:site_96 a wh:WorldHeritageSite ;
    rdfs:label "مدينة ستاري راس القديمة وسوبوتشاني"@ar,
        "Stari Ras and Sopoćani"@en,
        "Stari Ras y Sopoćani"@es,
        "Vieux Ras avec Sopoćani"@fr,
        "Древний город Стари-Рас и монастырь Сопочани"@ru,
        "斯塔里斯和索泼查尼修道院"@zh ;
    wh:areaHectares 198.72 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "On the outskirts of Stari Ras, the first capital of Serbia, there is an impressive group of medieval monuments consisting of fortresses, churches and monasteries. The monastery at Sopoćani is a reminder of the contacts between Western civilization and the Byzantine world."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_96-001,
        wh:component_96-002,
        wh:component_96-003,
        wh:component_96-004 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_iii ;
