        wh:criterion_vii,
        wh:criterion_viii,
        wh:criterion_x ;
    wh:hasImage wh:image_04ae887104352c3b,
        wh:image_15dd5858e5efb5c1,
        wh:image_1ec7fa2a4fddeec6,
