wh:site_1768 a wh:WorldHeritageSite ;
    rdfs:label "مدن السلطنات التاريخية في جزر القمر"@ar,
        "The Medinas of the Historic Sultanates of the Comoros"@en,
        "Las medinas de los sultanatos históricos de las Comoras"@es,
        "Les médinas des Sultanats historiques des Comores"@fr,
        "Медины исторических султанатов Коморских Островов"@ru,
        "科摩罗历史苏丹国麦地那"@zh ;
    wh:areaHectares 30.47 ;
    wh:belongsToRegion wh:region_AFR ;
    wh:description "The serial property is composed of six historic towns which developed from urban nuclei that emerged around at least the 11th century and evolved into city-states around the 14th-15th century. They eventually became the principal urban centres of the sultanates established on the islands of the archipelago of Comoros. With a common hierarchical system of social organisation, based on matrilineal and matrilocal customs, age-group systems, and patrilineal Islamic traditions still alive today, the property showcases insular urban forms and architectural expressions that resulted from cultural exchanges related to migration and Indian Ocean trade networks, embedded in the local social, geographical, and environmental context."@en ;
    wh:hasCategory wh:category_Cultural ;
