wh:site_602 a wh:WorldHeritageSite ;
    rdfs:label "وسط بخارى التاريخي"@ar,
        "Historic Centre of Bukhara"@en,
        "Centro histórico de Bujara"@es,
        "Centre historique de Boukhara"@fr,
        "Исторический центр города Бухара"@ru,
        "布哈拉历史中心"@zh ;
    wh:areaHectares 216.0 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "Bukhara, which is situated on the Silk Route, is more than 2,000 years old. It is the most complete example of a medieval city in Central Asia, with an urban fabric that has remained largely intact. Monuments of particular interest include the famous tomb of Ismail Samani, a masterpiece of 10th-century Muslim architecture, and a large number of 17th-century madrasas."@en ;
