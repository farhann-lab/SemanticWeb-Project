wh:site_532 a wh:WorldHeritageSite ;
    rdfs:label "قصور وحدائق بوتسدام وبرلين"@ar,
        "Palaces and Parks of Potsdam and Berlin"@en,
        "Palacios y parques de Potsdam y Berlín"@es,
        "Châteaux et parcs de Potsdam et Berlin"@fr,
        "Дворцы и парки Потсдама и Берлина"@ru,
        "波兹坦与柏林的宫殿与庭园"@zh ;
    wh:areaHectares 2064.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "With 500 ha of parks and 150 buildings constructed between 1730 and 1916, Potsdam's complex of palaces and parks forms an artistic whole, whose eclectic nature reinforces its sense of uniqueness. It extends into the district of Berlin-Zehlendorf, with the palaces and parks lining the banks of the River Havel and Lake Glienicke. Voltaire stayed at the Sans-Souci Palace, built under Frederick II between 1745 and 1747."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_532ter ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_ii,
        wh:criterion_iv ;
