wh:site_371 a wh:WorldHeritageSite ;
    rdfs:label "عنق جسر ايرونبريدج  (جسر الحديد)"@ar,
        "Ironbridge Gorge"@en,
        "Garganta de Ironbridge"@es,
        "Gorge d'Ironbridge"@fr,
        "Ущелье Айрон-Бридж"@ru,
        "乔治铁桥区"@zh ;
    wh:areaHectares 547.9 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Ironbridge is known throughout the world as the symbol of the Industrial Revolution. It contains all the elements of progress that contributed to the rapid development of this industrial region in the 18th century, from the mines themselves to the railway lines. Nearby, the blast furnace of Coalbrookdale, built in 1708, is a reminder of the discovery of coke. The bridge at Ironbridge, the world's first bridge constructed of iron, had a considerable influence on developments in the fields of technology and architecture."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_371 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_ii,
        wh:criterion_iv ;
    wh:hasImage wh:image_252db97593cb300b,
        wh:image_25db65633e86d41b,
        wh:image_266a3d47c28a292f,
        wh:image_2ad694894711cf33,
        wh:image_36baa22804bcbb41,
        wh:image_52c99688a5418140,
        wh:image_672c425e70614813,
        wh:image_a03757a35bc55dd1,
        wh:image_cf14ab1b982f094b,
        wh:image_db6625308bdfcbb5,
        wh:image_dd9faece8c6ad474,
        wh:image_e1a49ea51078bae5,
        wh:image_e5743cc0794e6abb,
        wh:image_e677740d362749a4,
