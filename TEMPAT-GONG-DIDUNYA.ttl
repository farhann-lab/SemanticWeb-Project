wh:site_1536 a wh:WorldHeritageSite ;
    rdfs:label "Kujataa Greenland: Norse and Inuit Farming at the Edge of the Ice Cap"@en,
        "Kujataa en Groenlandia: agricultura nórdica e inuit al borde del casquete glaciar"@es,
        "Kujataa au Groenland : agriculture nordique et inuite en bordure de la calotte glaciaire"@fr ;
    wh:areaHectares 34.892 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Kujataa is a subarctic farming landscape located in the southern region of Greenland. It bears witness to the cultural histories of the Norse farmer-hunters who started arriving from Iceland in the 10th century and of the Inuit hunters and Inuit farming communities that developed from the end of the 18th century. Despite their differences, the two cultures, European Norse and Inuit, created a cultural landscape based on farming, grazing and marine mammal hunting. The landscape represents the earliest introduction of farming to the Arctic, and the Norse expansion of settlement beyond Europe."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1536-001,
        wh:component_1536-002,
        wh:component_1536-003,
        wh:component_1536-004,
        wh:component_1536-005 ;
    wh:hasCriterion wh:criterion_v ;
