wh:site_492 a wh:WorldHeritageSite ;
    rdfs:label "هنود تاوس الحمر"@ar,
        "Taos Pueblo"@en,
        "Pueblo de Taos"@es,
        "Taos Pueblo"@fr,
        "Индейское поселение Пуэбло-де-Таос"@ru,
        "陶斯印第安村"@zh ;
    wh:areaHectares 19.01 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Situated in the valley of a small tributary of the Rio Grande, this adobe settlement – consisting of dwellings and ceremonial buildings – represents the culture of the Pueblo Indians of Arizona and New Mexico."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_492rev ;
    wh:hasCriterion wh:criterion_iv ;
    wh:hasImage wh:image_182bdb511dac6710,
