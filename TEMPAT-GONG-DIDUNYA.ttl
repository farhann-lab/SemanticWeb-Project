wh:site_114 a wh:WorldHeritageSite ;
    rdfs:label "بيرسبوليس"@ar,
        "Persepolis"@en,
        "Persépolis"@es,
        "Persépolis"@fr,
        "Древний город Персеполь"@ru,
        "波斯波利斯"@zh ;
    wh:areaHectares 12.5 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "Founded by Darius I in 518 B.C., Persepolis was the capital of the Achaemenid Empire. It was built on an immense half-artificial, half-natural terrace, where the king of kings created an impressive palace complex inspired by Mesopotamian models. The importance and quality of the monumental ruins make it a unique archaeological site."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_114 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_iii ;
    wh:hasImage wh:image_026973fbe934fee1,
        wh:image_03dfb1f316ed90f9,
        wh:image_10812dc2ac28591c,
        wh:image_1b29870b3a669fce,
