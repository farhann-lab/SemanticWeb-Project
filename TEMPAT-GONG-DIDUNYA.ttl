wh:site_778 a wh:WorldHeritageSite ;
    rdfs:label "منتزه لوشان الوطني"@ar,
        "Lushan National Park"@en,
        "Parque Nacional de Lushan"@es,
        "Parc national de Lushan"@fr,
        "Национальный парк Лушань"@ru,
        "庐山国家公园"@zh ;
    wh:areaHectares 30200.0 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "Mount Lushan, in Jiangxi, is one of the spiritual centres of Chinese civilization. Buddhist and Taoist temples, along with landmarks of Confucianism, where the most eminent masters taught, blend effortlessly into a strikingly beautiful landscape which has inspired countless artists who developed the aesthetic approach to nature found in Chinese culture."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_778 ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_iii,
        wh:criterion_iv ;
    wh:hasImage wh:image_0b2b50eee0156294,
        wh:image_1e8e71ddee82e31a,
        wh:image_3973f0b6a16f5aff,
