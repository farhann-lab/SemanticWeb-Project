wh:site_630 a wh:WorldHeritageSite ;
    rdfs:label "جزيرة فرايزر"@ar,
        "K’gari"@en,
        "K’gari"@es,
        "K’gari"@fr,
        "Остров Фрейзера"@ru,
        "弗雷泽岛"@zh ;
