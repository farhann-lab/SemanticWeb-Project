wh:site_1769 a wh:WorldHeritageSite ;
    rdfs:label "قرية سيدي بوسعيد"@ar,
        "Village of Sidi Bou Saïd"@en,
        "Pueblo de Sidi Bou Said"@es,
        "Village de Sidi Bou Saïd"@fr,
        "Деревня Сиди-Бу-Саид"@ru,
        "西迪布赛义德村"@zh ;
    wh:areaHectares 76.54 ;
    wh:belongsToRegion wh:region_ARB ;
    wh:description "The property is a picturesque village perched on a promontory overlooking the Mediterranean Sea, harmoniously integrated into the cliff topography. It developed around the tomb of a Sufi master and saint, known as Sidi Bou Saïd, who lived in the 12th-13th centuries. Through its architectural fabric and urban planning in symbiosis with the natural environment, its recognisable aesthetic created by emblematic colours, and a mystic aura associated with the Sufi spirituality that permeates the site, the property brings together geomorphology, architecture, and spirituality. It has long inspired artists and continues to attract visitors seeking spiritual serenity."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1769 ;
    wh:hasCriterion wh:criterion_iii ;
