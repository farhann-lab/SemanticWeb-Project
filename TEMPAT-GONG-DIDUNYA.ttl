wh:site_517 a wh:WorldHeritageSite ;
    rdfs:label "موقع أولمبيا الأثري"@ar,
        "Archaeological Site of Olympia"@en,
        "Sitio arqueológico de Olimpia"@es,
        "Site archéologique d'Olympie"@fr,
        "Археологические памятники Олимпии"@ru,
        "奥林匹亚考古遗址"@zh ;
    wh:areaHectares 105.608 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The site of Olympia, in a valley in the Peloponnesus, has been inhabited since prehistoric times. In the 10th century B.C., Olympia became a centre for the worship of Zeus. The Altis – the sanctuary to the gods – has one of the highest concentrations of masterpieces from the ancient Greek world. In addition to temples, there are the remains of all the sports structures erected for the Olympic Games, which were held in Olympia every four years beginning in 776 B.C."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_517 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_ii,
        wh:criterion_iii,
        wh:criterion_iv ;
