wh:site_22 a wh:WorldHeritageSite ;
    rdfs:label "مدينة بصرى القديمة"@ar,
        "Ancient City of Bosra"@en,
        "Ciudad vieja de Bosra"@es,
        "Ancienne ville de Bosra"@fr,
        "Старый город в Босре"@ru,
