wh:site_987 a wh:WorldHeritageSite ;
    rdfs:label "أسوار لوغو الرومانية"@ar,
        "Roman Walls of Lugo"@en,
        "Muralla romana de Lugo"@es,
        "Remparts romains de Lugo"@fr,
        "Древнеримские стены в городе Луго"@ru,
        "卢戈的罗马城墙"@zh ;
    wh:areaHectares 1.68 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The walls of Lugo were built in the later part of the 3rd century to defend the Roman town of Lucus. The entire circuit survives intact and is the finest example of late Roman fortifications in western Europe."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_987 ;
    wh:hasCriterion wh:criterion_iv ;
    wh:hasImage wh:image_1739400dc89097e2,
        wh:image_3d08e9b9d9f0e68c,
        wh:image_4f61a019d096c0e3,
        wh:image_65a106511c43cc4d,
