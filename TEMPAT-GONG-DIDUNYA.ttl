wh:site_347 a wh:WorldHeritageSite ;
    rdfs:label "مدينة سانتياغو دي كومبوستيل القديمة"@ar,
        "Santiago de Compostela (Old Town)"@en,
        "Ciudad vieja de Santiago de Compostela"@es,
        "Vieille ville de Saint-Jacques-de-Compostelle"@fr,
        "Старый город в Сантьяго-де-Компостела"@ru,
        "圣地亚哥–德孔波斯特拉古城"@zh ;
    wh:areaHectares 107.59 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "This famous pilgrimage site in north-west Spain became a symbol in the Spanish Christians' struggle against Islam. Destroyed by the Muslims at the end of the 10th century, it was completely rebuilt in the following century. With its Romanesque, Gothic and Baroque buildings, the Old Town of Santiago is one of the world's most beautiful urban areas. The oldest monuments are grouped around the tomb of St James and the cathedral, which contains the remarkable Pórtico de la Gloria."@en ;
