wh:site_1010 a wh:WorldHeritageSite ;
    rdfs:label "أرض اللبان"@ar,
        "Land of Frankincense"@en,
        "Tierra del incienso"@es,
        "Terre de l’encens"@fr,
        "Древний торговый путь “Тропа ладана”"@ru,
        "乳香之路"@zh ;
    wh:areaHectares 849.88 ;
    wh:belongsToRegion wh:region_ARB ;
    wh:description "The frankincense trees of Wadi Dawkah and the remains of the caravan oasis of Shisr/Wubar and the affiliated ports of Khor Rori and Al-Baleed vividly illustrate the trade in frankincense that flourished in this region for many centuries, as one of the most important trading activities of the ancient and medieval world."@en ;
