wh:site_841 a wh:WorldHeritageSite ;
    rdfs:label "قصر سان بيدور دي لا روكا، سانتياغو"@ar,
        "San Pedro de la Roca Castle, Santiago de Cuba"@en,
        "Castillo de San Pedro de la Roca en Santiago de Cuba"@es,
        "Château de San Pedro de la Roca, Santiago de Cuba"@fr,
        "Крепость Сан-Педро-де-ла-Рока в городе Сантьяго-де-Куба"@ru,
        "古巴圣地亚哥的圣佩德罗德拉罗卡堡"@zh ;
    wh:areaHectares 93.88 ;
    wh:belongsToRegion wh:region_LAC ;
    wh:description "Commercial and political rivalries in the Caribbean region in the 17th century resulted in the construction of this massive series of fortifications on a rocky promontory, built to protect the important port of Santiago. This intricate complex of forts, magazines, bastions and batteries is the most complete, best-preserved example of Spanish-American military architecture, based on Italian and Renaissance design principles."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_841 ;
    wh:hasCriterion wh:criterion_iv,
        wh:criterion_v ;
