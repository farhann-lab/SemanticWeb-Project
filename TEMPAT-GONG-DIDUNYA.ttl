wh:site_121 a wh:WorldHeritageSite ;
    rdfs:label "وادي كاتماندو"@ar,
        "Kathmandu Valley"@en,
        "Valle de Katmandú"@es,
        "Vallée de Kathmandu"@fr,
        "Долина Катманду"@ru,
