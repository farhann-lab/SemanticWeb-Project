wh:site_597 a wh:WorldHeritageSite ;
    rdfs:label "دير هوريزو"@ar,
        "Hurezi Monastery"@en,
        "Monasterio de Horezu"@es,
        "Monastère de Hurezi"@fr,
        "Монастырь Хорезу"@ru,
        "霍雷祖修道院"@zh ;
    wh:areaHectares 22.48 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Founded in 1690 by Prince Constantine Brancovan, the Hurezi Monastery, in Walachia, is a masterpiece of the 'Brancovan' style. It is known for its architectural purity and balance, the richness of its sculptural detail, the treatment of its religious compositions, its votive portraits and its painted decorative works. The school of mural and icon painting established at the monastery in the 18th century was famous throughout the Balkan region."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_597 ;
    wh:hasCriterion wh:criterion_ii ;
