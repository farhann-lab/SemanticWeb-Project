wh:site_1433 a wh:WorldHeritageSite ;
    rdfs:label "مهد ولادة يسوع المسيح: كنيسة المهد وطريق الحجاج، بيت لحم"@ar,
        "Birthplace of Jesus: Church of the Nativity and the Pilgrimage Route, Bethlehem"@en,
        "El Lugar de Nacimiento de Jesús: Iglesia de la Natividad y ruta de peregrinación en Belén"@es,
        "Lieu de naissance de Jésus : l’église de la Nativité et la route de pèlerinage, Bethléem"@fr,
        "Базилика Рождества Христова и тропы паломников"@ru,
        "耶稣诞生地：伯利恒主诞堂和朝圣线路"@zh ;
    wh:areaHectares 2.98 ;
    wh:belongsToRegion wh:region_ARB ;
    wh:description "The inscribed property is situated 10 km south of Jerusalem on the site identified by Christian tradition as the birthplace of Jesus since the 2nd century. A church was first completed there in ad 339 and the edifice that replaced it after a fire in the 6th century retains elaborate floor mosaics from the original building. The site also includes Latin, Greek Orthodox, Franciscan and Armenian convents and churches, as well as bell towers, terraced gardens and a pilgrimage route."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1433 ;
    wh:hasCriterion wh:criterion_iv ;
    wh:hasImage wh:image_128398b04cf94bf9,
        wh:image_3351bfa2dbf993a3,
