wh:site_30 a wh:WorldHeritageSite ;
    rdfs:label "وسط وارسو التاريخي"@ar,
        "Historic Centre of Warsaw"@en,
        "Centro histórico de Varsovia"@es,
        "Centre historique de Varsovie"@fr,
        "Исторический центр Варшавы"@ru,
        "华沙历史中心"@zh ;
    wh:areaHectares 25.93 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "During the Warsaw Uprising in August 1944, more than 85% of Warsaw's historic centre was destroyed by Nazi troops. After the war, a five-year reconstruction campaign by its citizens resulted in today's meticulous restoration of the Old Town, with its churches, palaces and market-place. It is an outstanding example of a near-total reconstruction of a span of history covering the 13th to the 20th century."@en ;
