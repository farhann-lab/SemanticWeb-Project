wh:site_810 a wh:WorldHeritageSite ;
    rdfs:label "مدينة تروغير التاريخيّة"@ar,
        "Historic City of Trogir"@en,
        "Ciudad histórica de Trogir"@es,
        "Ville historique de Trogir"@fr,
        "Исторический город Трогир"@ru,
        "历史名城特罗吉尔"@zh ;
    wh:areaHectares 6.4 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Trogir is a remarkable example of urban continuity. The orthogonal street plan of this island settlement dates back to the Hellenistic period and it was embellished by successive rulers with many fine public and domestic buildings and fortifications. Its beautiful Romanesque churches are complemented by the outstanding Renaissance and Baroque buildings from the Venetian period."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_810 ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_iv ;
    wh:hasImage wh:image_1157ab6556ed4a0d,
        wh:image_144d714ebcc7c476,
        wh:image_2bf0e31836186348,
        wh:image_2f30900f3e2d1f39,
