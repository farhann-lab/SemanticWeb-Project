wh:site_28 a wh:WorldHeritageSite ;
    rdfs:label "منتزه ييلوستون الوطني"@ar,
        "Yellowstone National Park"@en,
        "Parque Nacional de Yellowstone"@es,
        "Parc national de Yellowstone"@fr,
        "Йеллоустонский национальный парк"@ru,
        "黄石国家公园"@zh ;
    wh:areaHectares 898349.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The vast natural forest of Yellowstone National Park covers nearly 9,000 km2 ; 96% of the park lies in Wyoming, 3% in Montana and 1% in Idaho. Yellowstone contains half of all the world's known geothermal features, with more than 10,000 examples. It also has the world's largest concentration of geysers (more than 300 geyers, or two thirds of all those on the planet). Established in 1872, Yellowstone is equally known for its wildlife, such as grizzly bears, wolves, bison and wapitis."@en ;
    wh:hasCategory wh:category_Natural ;
    wh:hasComponent wh:component_28 ;
    wh:hasCriterion wh:criterion_ix,
        wh:criterion_vii,
        wh:criterion_viii,
        wh:criterion_x ;
    wh:hasImage wh:image_0b1942e91ebc9762,
        wh:image_2a6c2b693fc8edfe,
        wh:image_3298e630c07a69c7,
        wh:image_35740ce87af69ed6,
