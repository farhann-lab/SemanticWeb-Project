wh:site_119 a wh:WorldHeritageSite ;
    rdfs:label "تمبوكتو"@ar,
        "Timbuktu"@en,
        "Tombuctú"@es,
        "Tombouctou"@fr,
        "Исторический город Томбукту"@ru,
        "廷巴克图"@zh ;
    wh:areaHectares 0.0 ;
    wh:belongsToRegion wh:region_AFR ;
    wh:description "Home of the prestigious Koranic Sankore University and other madrasas, Timbuktu was an intellectual and spiritual capital and a centre for the propagation of Islam throughout Africa in the 15th and 16th centuries. Its three great mosques, Djingareyber, Sankore and Sidi Yahia, recall Timbuktu's golden age. Although continuously restored, these monuments are today under threat from desertification."@en ;
