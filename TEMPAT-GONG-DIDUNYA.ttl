    rdfs:label "مناجم الصوان من العصر الحجري الحديث في سبيين- (مونس)"@ar,
        "Neolithic Flint Mines at Spiennes (Mons)"@en,
        "Minas neolíticas de sílex de Spiennes (Mons)"@es,
        "Minières néolithiques de silex de Spiennes (Mons)"@fr,
        "Неолитические каменоломни в районе Спьенн, окрестности города Монс"@ru,
