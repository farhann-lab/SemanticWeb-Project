wh:site_726 a wh:WorldHeritageSite ;
    rdfs:label "الوسط التاريخي لنابولي"@ar,
        "Historic Centre of Naples"@en,
        "Centro histórico de Nápoles"@es,
        "Centre historique de Naples"@fr,
        "Исторический центр Неаполя"@ru,
        "那不勒斯历史中心"@zh ;
    wh:areaHectares 1021.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "From the Neapolis founded by Greek settlers in 470 B.C. to the city of today, Naples has retained the imprint of the successive cultures that emerged in Europe and the Mediterranean basin. This makes it a unique site, with a wealth of outstanding monuments such as the Church of Santa Chiara and the Castel Nuovo."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_726-001,
        wh:component_726-002,
        wh:component_726-003,
        wh:component_726-004 ;
    wh:hasCriterion wh:criterion_ii,
        wh:criterion_iv ;
    wh:hasImage wh:image_075043fae9b0a4ca,
        wh:image_0cc859b9edc29467,
        wh:image_0ed08b2558548cd7,
