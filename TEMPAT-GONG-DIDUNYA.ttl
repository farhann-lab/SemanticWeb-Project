wh:site_793 a wh:WorldHeritageSite ;
    rdfs:label "مدينة مكناس التاريخيّة"@ar,
        "Historic City of Meknes"@en,
        "Ciudad histórica de Mequínez"@es,
        "Ville historique de Meknès"@fr,
        "Исторический город Мекнес"@ru,
        "历史名城梅克内斯"@zh ;
    wh:belongsToRegion wh:region_ARB ;
    wh:description "Founded in the 11th century by the Almoravids as a military settlement, Meknes became a capital under Sultan Moulay Ismaïl (1672–1727), the founder of the Alawite dynasty. The sultan turned it into a impressive city in Spanish-Moorish style, surrounded by high walls with great doors, where the harmonious blending of the Islamic and European styles of the 17th century Maghreb are still evident today."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_793 ;
    wh:hasCriterion wh:criterion_iv ;
