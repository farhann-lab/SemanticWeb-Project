wh:site_868 a wh:WorldHeritageSite ;
    rdfs:label "طرق سان جاك دو كومبوستيل  في فرنسا"@ar,
        "Routes of Santiago de Compostela in France"@en,
        "Caminos de Santiago de Compostela en Francia"@es,
