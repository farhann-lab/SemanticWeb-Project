wh:site_188 a wh:WorldHeritageSite ;
    rdfs:label "وادي مزاب"@ar,
        "M'Zab Valley"@en,
        "Valle del M’Zab"@es,
        "Vallée du M'Zab"@fr,
        "Долина Мзаб"@ru,
        "姆扎卜山谷"@zh ;
    wh:areaHectares 665.03 ;
    wh:belongsToRegion wh:region_ARB ;
    wh:description "A traditional human habitat, created in the 10th century by the Ibadites around their five ksour (fortified cities), has been preserved intact in the M’Zab valley. Simple, functional and perfectly adapted to the environment, the architecture of M’Zab was designed for community living, while respecting the structure of the family. It is a source of inspiration for today’s urban planners."@en ;
