wh:site_913 a wh:WorldHeritageSite ;
    rdfs:label "مزارات ومعابد نيكو"@ar,
        "Shrines and Temples of Nikko"@en,
        "Santuarios y templos de Nikko"@es,
        "Sanctuaires et temples de Nikko"@fr,
        "Святилища и храмы Никко"@ru,
        "日光神殿和庙宇"@zh ;
    wh:areaHectares 50.8 ;
    wh:belongsToRegion wh:region_APA ;
    wh:description "The shrines and temples of Nikko, together with their natural surroundings, have for centuries been a sacred site known for its architectural and decorative masterpieces. They are closely associated with the history of the Tokugawa Shoguns."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_913 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_iv ;
