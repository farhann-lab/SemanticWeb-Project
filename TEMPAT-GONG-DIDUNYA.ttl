    rdfs:label "محمية الزهور في الكاب"@ar,
        "Cape Floral Region Protected Areas"@en,
        "Áreas protegidas de la Región Floral de El Cabo"@es,
        "Aires protégées de la Région Florale du Cap"@fr,
