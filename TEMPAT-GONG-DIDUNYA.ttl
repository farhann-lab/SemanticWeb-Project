wh:site_1463 a wh:WorldHeritageSite ;
    rdfs:label "قناة بادري تمبليكي، مجمع هيدرولوجي من عصر النهضة في أمريكا"@ar,
        "Aqueduct of Padre Tembleque Hydraulic System"@en,
        "Sistema hidráulico del acueducto del Padre Tembleque"@es,
        "Système hydraulique de l'aqueduc de Padre Tembleque"@fr,
        "Гидравлический комплекс «Акведук Падре Темблеке»"@ru,
        "腾布里克神父水道桥水利设施"@zh ;
    wh:areaHectares 6540.0 ;
    wh:belongsToRegion wh:region_LAC ;
    wh:description "This 16th century aqueduct is located between the states of Mexico and Hidalgo, on the Central Mexican Plateau. This heritage canal system encompasses a water catchment area, springs, canals, distribution tanks and arcaded aqueduct bridges. The site incorporates the highest single-level arcade ever built in an aqueduct. Initiated by the Franciscan friar, Padre Tembleque, and built with support from the local indigenous communities, this hydraulic system is an example of the exchange of influences between the European tradition of Roman hydraulics and traditional Mesoamerican construction techniques, including the use of adobe."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1463 ;
    wh:hasCriterion wh:criterion_i,
        wh:criterion_ii,
        wh:criterion_iv ;
