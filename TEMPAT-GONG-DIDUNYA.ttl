        wh:criterion_iii,
        wh:criterion_iv ;
    wh:hasImage wh:image_2b17b75e8e5427eb,
        wh:image_2fca17ca99f6be3f,
        wh:image_39bdfc60893538b1,
        wh:image_62a05ae668f9bddc,
