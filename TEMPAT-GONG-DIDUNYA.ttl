wh:site_960 a wh:WorldHeritageSite ;
    rdfs:label "دير غيرارت  والوادي الأعلى في أزات"@ar,
        "Monastery of Geghard and the Upper Azat Valley"@en,
        "Monasterio de Geghard y valle alto del Azat"@es,
        "Monastère de Gherart et la Haute vallée de l’Azat"@fr,
        "Монастырь Гегард и верховья реки Азат"@ru,
        "格加尔德修道院和上阿扎特山谷"@zh ;
    wh:areaHectares 2.97 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "The monastery of Geghard contains a number of churches and tombs, most of them cut into the rock, which illustrate the very peak of Armenian medieval architecture. The complex of medieval buildings is set into a landscape of great natural beauty, surrounded by towering cliffs at the entrance to the Azat Valley."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_960 ;
    wh:hasCriterion wh:criterion_ii ;
    wh:hasImage wh:image_02c49e05953f3acf,
        wh:image_0962ec65cc427bf7,
