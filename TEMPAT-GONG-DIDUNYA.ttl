wh:site_1042 a wh:WorldHeritageSite ;
    rdfs:label "مدينة عكّا القديمة"@ar,
        "Old City of Acre"@en,
        "Ciudad vieja de Acre"@es,
        "Vieille ville d’Acre"@fr,
        "Старый город в Акре (Акко)"@ru,
        "阿克古城"@zh ;
    wh:areaHectares 63.3 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Acre is a historic walled port-city with continuous settlement from the Phoenician period. The present city is characteristic of a fortified town dating from the Ottoman 18th and 19th centuries, with typical urban components such as the citadel, mosques, khans and baths. The remains of the Crusader town, dating from 1104 to 1291, lie almost intact, both above and below today's street level, providing an exceptional picture of the layout and structures of the capital of the medieval Crusader kingdom of Jerusalem."@en ;
    wh:hasCategory wh:category_Cultural ;
    wh:hasComponent wh:component_1042 ;
    wh:hasCriterion wh:criterion_ii,
