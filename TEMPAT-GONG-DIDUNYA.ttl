    wh:uuid "a298c9cc-836a-595d-b2e9-a97cab9e91f1"^^xsd:string .

wh:site_720 a wh:WorldHeritageSite ;
    rdfs:label "Messel Pit Fossil Site"@en,
        "Sitio fosilífero de Messel"@es,
        "Site fossilifère de Messel"@fr,
        "麦塞尔化石遗址"@zh ;
    wh:areaHectares 42.0 ;
    wh:belongsToRegion wh:region_EUR ;
    wh:description "Messel Pit is the richest site in the world for understanding the living environment of the Eocene, between 57 million and 36 million years ago. In particular, it provides unique information about the early stages of the evolution of mammals and includes exceptionally well-preserved mammal fossils, ranging from fully articulated skeletons to the contents of stomachs of animals of this period."@en ;
