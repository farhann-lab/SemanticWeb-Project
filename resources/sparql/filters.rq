PREFIX wh:   <https://example.org/heritage/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?type ?iri ?label
WHERE {
    VALUES (?type ?class) {
        ("country"   wh:Country)
        ("region"    wh:Region)
        ("category"  wh:Category)
        ("criterion" wh:Criterion)
    }
    ?iri a ?class ;
         rdfs:label ?label .
    FILTER(LANG(?label) = "en")
    FILTER(?type != "country" || EXISTS { ?site wh:locatedIn ?iri })
}
