PREFIX wh:   <https://example.org/heritage/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?heritage ?name ?yearNum
WHERE {
    ?heritage a wh:WorldHeritageSite ;
              rdfs:label ?name .
    FILTER(LANG(?name) = "en")

    OPTIONAL { ?heritage wh:inscriptionYear ?inscriptionYear }
    BIND(xsd:integer(STR(?inscriptionYear)) AS ?yearNum)

    {{CONDITIONS}}
}
ORDER BY {{SORT}}
LIMIT {{LIMIT}}
OFFSET {{OFFSET}}
