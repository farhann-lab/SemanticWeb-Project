PREFIX wh:   <https://example.org/heritage/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?name ?countryLabel ?regionLabel ?categoryLabel ?criterionLabel
       ?inscriptionYear ?isInDanger ?isTransboundary
       ?areaHectares ?description ?justification
WHERE {
    BIND(wh:{{HERITAGE_ID}} AS ?heritage)

    ?heritage a wh:WorldHeritageSite ;
              rdfs:label ?name .
    FILTER(LANG(?name) = "en")

    OPTIONAL { ?heritage wh:locatedIn ?country . ?country rdfs:label ?countryLabel . FILTER(LANG(?countryLabel) = "en") }
    OPTIONAL { ?heritage wh:belongsToRegion ?region . ?region rdfs:label ?regionLabel . FILTER(LANG(?regionLabel) = "en") }
    OPTIONAL { ?heritage wh:hasCategory ?category . ?category rdfs:label ?categoryLabel . FILTER(LANG(?categoryLabel) = "en") }
    OPTIONAL { ?heritage wh:hasCriterion ?criterion . ?criterion rdfs:label ?criterionLabel }
    OPTIONAL { ?heritage wh:inscriptionYear ?inscriptionYear }
    OPTIONAL { ?heritage wh:isInDanger ?isInDanger }
    OPTIONAL { ?heritage wh:isTransboundary ?isTransboundary }
    OPTIONAL { ?heritage wh:areaHectares ?areaHectares }
    OPTIONAL { ?heritage wh:description ?description . FILTER(LANG(?description) = "en") }
    OPTIONAL { ?heritage wh:justification ?justification . FILTER(LANG(?justification) = "en") }
}
