PREFIX wh:   <https://example.org/heritage/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?heritage
       ?name
       ?country
       ?region
       ?category
       ?criterion
       ?inscriptionYear
       ?isInDanger
       ?isTransboundary
       ?areaHectares
WHERE {
    BIND(wh:{{HERITAGE_ID}} AS ?heritage)

    ?heritage a wh:WorldHeritageSite ;
              rdfs:label ?name .

    OPTIONAL {
        ?heritage wh:locatedIn ?country .
    }

    OPTIONAL {
        ?heritage wh:belongsToRegion ?region .
    }

    OPTIONAL {
        ?heritage wh:hasCategory ?category .
    }

    OPTIONAL {
        ?heritage wh:hasCriterion ?criterion .
    }

    OPTIONAL {
        ?heritage wh:inscriptionYear ?inscriptionYear .
    }

    OPTIONAL {
        ?heritage wh:isInDanger ?isInDanger .
    }

    OPTIONAL {
        ?heritage wh:isTransboundary ?isTransboundary .
    }

    OPTIONAL {
        ?heritage wh:areaHectares ?areaHectares .
    }

    FILTER(LANG(?name) = "en")
}